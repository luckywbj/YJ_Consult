/** app.wxss **/
page {
  --primary-color: #8D6238;
  --primary-dark: #6E4924;
  --primary-light: #E7D5BF;
  --gold-accent: #B88B4A;
  --bg-color: #F8F6F2;
  --card-bg: #FFFFFF;
  --text-title: #221D1A;
  --text-main: #3F3732;
  --text-sub: #7D736A;
  --text-muted: #A89F95;
  --border-light: #ECE5DC;

  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, "Songti SC", "Noto Serif SC", "STSong", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
  color: var(--text-main);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 优雅阴影卡片 */
.luxury-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  box-shadow: 0 10rpx 36rpx rgba(141, 98, 56, 0.08);
  border: 1rpx solid rgba(231, 213, 191, 0.4);
}

/* 标题下方的极简粗短横线 */
.section-indicator {
  width: 48rpx;
  height: 6rpx;
  background-color: #26211E;
  margin: 16rpx auto 36rpx auto;
  border-radius: 3rpx;
}

/* 金色高贵主按钮 */
.gold-btn {
  background: linear-gradient(135deg, #A88152 0%, #8D6238 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  padding: 22rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(141, 98, 56, 0.28);
  transition: all 0.2s ease;
}

.gold-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

/* 按钮描边样式 */
.gold-btn-outline {
  background: transparent;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 44rpx;
  padding: 20rpx 46rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

/* 安全区域补丁 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
