/* pages/brochure/brochure.wxss */
.brochure-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: 180rpx;
}

/* 顾问工具条 */
.staff-toolbar {
  background: #241E1A;
  padding: 16rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.st-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.st-badge {
  font-size: 19rpx;
  color: #241E1A;
  background: #E2B678;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
}

.st-desc {
  font-size: 22rpx;
  color: #F4EAE0;
}

.st-btns {
  display: flex;
  gap: 10rpx;
}

.st-btn {
  font-size: 21rpx;
  color: #F4EAE0;
  background: rgba(255, 255, 255, 0.14);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.st-btn.gold {
  background: #8D6238;
  color: #FFFFFF;
  font-weight: 600;
}

/* 文章头部 */
.article-header {
  padding: 32rpx 32rpx 24rpx 32rpx;
}

.article-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1E1915;
  line-height: 1.4;
  margin-bottom: 18rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.meta-date {
  color: #8C8074;
}

.meta-author {
  color: #8D6238;
  font-weight: 600;
}

.article-stats {
  font-size: 24rpx;
  color: #7D736A;
}

.stat-num {
  color: #3D5B99;
  font-weight: 600;
}

.stat-num.hot {
  color: #D24943;
}

.stat-sep {
  margin: 0 10rpx;
  color: #C2B7AA;
}

/* 嵌入式获客名片条 */
.biz-card {
  margin: 0 32rpx 30rpx 32rpx;
  background: #FAF8F4;
  border: 1rpx solid #EAE0D2;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(36, 30, 26, 0.04);
}

.bc-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bc-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  border: 2rpx solid #DFCBB2;
  flex-shrink: 0;
}

.bc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #241E1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bc-tag {
  font-size: 21rpx;
  color: #8C8074;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bc-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.bc-btn {
  font-size: 23rpx;
  font-weight: 600;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  color: #FFFFFF;
}

.bc-btn.phone {
  background: #2AA952;
}

.bc-btn.wechat {
  background: #D93B43;
}

/* 欢迎导语引用 */
.greeting-quote {
  margin: 0 32rpx 32rpx 32rpx;
  padding: 18rpx 22rpx;
  background: #FBF9F5;
  border-radius: 12rpx;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.quote-line {
  width: 6rpx;
  border-radius: 3rpx;
  background: #B88B4A;
  flex-shrink: 0;
}

.quote-text {
  font-size: 26rpx;
  color: #5C5248;
  line-height: 1.65;
}

/* 黑金品牌背书海报卡 */
.brand-poster-card {
  margin: 0 32rpx 36rpx 32rpx;
  background: linear-gradient(155deg, #211B17 0%, #372A20 100%);
  border-radius: 22rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  color: #FFFFFF;
  box-shadow: 0 12rpx 28rpx rgba(30, 25, 21, 0.18);
}

.bp-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid #E2B678;
  margin-bottom: 14rpx;
}

.bp-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFE5BF;
  margin-bottom: 6rpx;
}

.bp-sub {
  display: block;
  font-size: 22rpx;
  color: #C7B9A8;
  margin-bottom: 26rpx;
}

.bp-kpi-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid rgba(226, 182, 120, 0.22);
  padding-top: 22rpx;
}

.bp-kpi {
  flex: 1;
}

.bk-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #E2B678;
}

.bk-lbl {
  display: block;
  font-size: 20rpx;
  color: #C7B9A8;
  margin-top: 4rpx;
}

.bp-kpi-split {
  width: 1rpx;
  height: 44rpx;
  background: rgba(226, 182, 120, 0.22);
}

/* 正文小节 */
.article-body {
  padding: 0 32rpx;
}

.sec-block {
  margin-bottom: 36rpx;
}

.sec-heading {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #241E1A;
  margin-bottom: 14rpx;
}

.sec-content {
  display: block;
  font-size: 28rpx;
  color: #3F3732;
  line-height: 1.8;
  text-align: justify;
}

/* 转化引导卡 */
.convert-card {
  margin: 16rpx 32rpx 0 32rpx;
  background: #FAF6F0;
  border: 1rpx solid #E7D8C3;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  text-align: center;
}

.cc-title {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 8rpx;
}

.cc-sub {
  display: block;
  font-size: 22rpx;
  color: #7D736A;
  margin-bottom: 22rpx;
  line-height: 1.5;
}

.cc-btns {
  display: flex;
  gap: 16rpx;
}

.cc-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 36rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.cc-btn.outline {
  border: 1rpx solid #8D6238;
  color: #8D6238;
  background: #FFFFFF;
}

.cc-btn.solid {
  background: linear-gradient(135deg, #A88152 0%, #8D6238 100%);
  color: #FFFFFF;
}

/* 底部悬浮一键分享条 */
.share-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #EAE0D2;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)) 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 99;
}

.sb-wechat-btn {
  padding: 20rpx 26rpx;
  border-radius: 44rpx;
  border: 1rpx solid #8D6238;
  color: #8D6238;
  font-size: 26rpx;
  font-weight: 600;
  background: #FFFFFF;
  flex-shrink: 0;
}

.sb-share-btn {
  flex: 1;
  background: linear-gradient(135deg, #D93B43 0%, #B82931 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 20rpx 0;
  line-height: 1.25;
  margin: 0;
  box-shadow: 0 8rpx 20rpx rgba(217, 59, 67, 0.28);
}

.sb-share-btn::after {
  border: none;
}

/* 弹窗通用样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.modal-box {
  background: #FFFFFF;
  width: 100%;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
}

.wm-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.wm-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid #E2B678;
}

.wm-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wm-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
}

.wm-title {
  font-size: 22rpx;
  color: #7D736A;
}

.wm-id-box {
  background: #FAF7F2;
  border: 1rpx dashed #D8C3A8;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.wm-id-label {
  display: block;
  font-size: 22rpx;
  color: #8C8074;
  margin-bottom: 8rpx;
}

.wm-id-val {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #8D6238;
  margin-bottom: 10rpx;
}

.wm-note {
  display: block;
  font-size: 22rpx;
  color: #6E6257;
  line-height: 1.45;
}

.wm-btns {
  display: flex;
  gap: 16rpx;
}

.wm-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.wm-btn.cancel {
  background: #F2EDE6;
  color: #6B6158;
}

.wm-btn.confirm {
  background: #8D6238;
  color: #FFFFFF;
}

/* 编辑宣传单弹窗 */
.edit-box {
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.em-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 18rpx;
}

.em-scroll {
  max-height: 54vh;
  margin-bottom: 20rpx;
}

.ef-row {
  display: flex;
  gap: 14rpx;
}

.ef-group {
  margin-bottom: 16rpx;
}

.ef-group.half {
  flex: 1;
}

.ef-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #3A312A;
  margin-bottom: 6rpx;
}

.ef-input,
.ef-textarea {
  width: 100%;
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #241E1A;
  box-sizing: border-box;
}

.ef-textarea {
  height: 160rpx;
}

.ef-textarea.small {
  height: 108rpx;
}
