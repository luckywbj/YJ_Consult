<!-- pages/brochure/brochure.wxml -->
<view class="brochure-page" wx:if="{{brochure && activeCard}}">
  <!-- 顾问专属管理条（访客雷达 + 千人千名片切换 + 免发版改内容） -->
  <view class="staff-toolbar" wx:if="{{auth.role === 'admin'}}">
    <view class="st-left">
      <text class="st-badge">顾问获客</text>
      <text class="st-desc">{{activeCard.name}}</text>
    </view>
    <view class="st-btns">
      <text class="st-btn" bindtap="openVisitorModal">📊 访客雷达</text>
      <text class="st-btn" bindtap="switchStaffCard">🔄 换名片</text>
      <text class="st-btn gold" bindtap="openEditModal">✏️ 改内容</text>
    </view>
  </view>

  <!-- 1. 文章主标题与阅读/转发热度 -->
  <view class="article-header">
    <text class="article-title">{{brochure.title}}</text>
    <view class="article-meta">
      <text class="meta-date">{{brochure.publishDate}}</text>
      <text class="meta-author">{{brochure.author}}</text>
    </view>
    <view class="article-stats">
      有 <text class="stat-num">{{brochure.views}}</text> 人看过
      <text class="stat-sep">·</text>
      有 <text class="stat-num hot">{{brochure.shares}}</text> 人转发分享
    </view>
  </view>

  <!-- 2. 嵌入式获客名片条（打电话 / 加微信） -->
  <view class="biz-card">
    <view class="bc-left">
      <image class="bc-avatar" src="{{activeCard.avatar}}" mode="aspectFill"></image>
      <view class="bc-info">
        <text class="bc-name">{{activeCard.brandName}}</text>
        <text class="bc-tag">{{activeCard.tagline}}</text>
      </view>
    </view>
    <view class="bc-actions">
      <view class="bc-btn phone" bindtap="callCardPhone">打电话</view>
      <view class="bc-btn wechat" bindtap="openWechatModal">加微信</view>
    </view>
  </view>

  <!-- 3. 欢迎导语引用块 -->
  <view class="greeting-quote">
    <view class="quote-line"></view>
    <text class="quote-text">{{brochure.greeting}}</text>
  </view>

  <!-- 4. 黑金品牌主视觉背书卡 -->
  <view class="brand-poster-card">
    <image class="bp-avatar" src="{{activeCard.avatar}}" mode="aspectFill"></image>
    <text class="bp-title">{{activeCard.brandName}}</text>
    <text class="bp-sub">{{activeCard.title}}</text>
    <view class="bp-kpi-row">
      <view class="bp-kpi">
        <text class="bk-num">300+</text>
        <text class="bk-lbl">高净值私董</text>
      </view>
      <view class="bp-kpi-split"></view>
      <view class="bp-kpi">
        <text class="bk-num">10+年</text>
        <text class="bk-lbl">实战操盘</text>
      </view>
      <view class="bp-kpi-split"></view>
      <view class="bp-kpi">
        <text class="bk-num">8.6x</text>
        <text class="bk-lbl">平均客单跃迁</text>
      </view>
    </view>
  </view>

  <!-- 5. 公司简介图文段落 -->
  <view class="article-body">
    <view class="sec-block" wx:for="{{brochure.sections}}" wx:key="heading">
      <text class="sec-heading">{{item.heading}}</text>
      <text class="sec-content">{{item.content}}</text>
    </view>
  </view>

  <!-- 6. 承接转化直达区 -->
  <view class="convert-card">
    <text class="cc-title">想进一步了解合作与实战案例？</text>
    <text class="cc-sub">点击下方按钮可直接浏览标杆客户转型战果，或预约 1V1 深度问诊</text>
    <view class="cc-btns">
      <view class="cc-btn outline" bindtap="goToCases">看实战案例 ›</view>
      <view class="cc-btn solid" bindtap="goToServices">查看服务方案 ›</view>
    </view>
  </view>

  <!-- 7. 底部悬浮一键分享操作条 -->
  <view class="share-bottom-bar">
    <view class="sb-wechat-btn" bindtap="openWechatModal">💬 加微信</view>
    <button class="sb-share-btn" open-type="share">↪ 点击分享给好友</button>
  </view>

  <!-- ==================== 弹窗：加微信专属获客名片（支持长按识别云端二维码） ==================== -->
  <view class="modal-mask" wx:if="{{wechatModalVisible}}" bindtap="closeWechatModal">
    <view class="modal-box" catchtap="preventBubble">
      <view class="wm-top">
        <image class="wm-avatar" src="{{activeCard.avatar}}" mode="aspectFill"></image>
        <view class="wm-info">
          <text class="wm-name">{{activeCard.name}} · {{activeCard.brandName}}</text>
          <text class="wm-title">{{activeCard.title}}</text>
        </view>
      </view>

      <view class="wm-qr-wrap" wx:if="{{activeCard.wechatQr}}">
        <image class="wm-qr-img" src="{{activeCard.wechatQr}}" mode="aspectFit" show-menu-by-longpress="true"></image>
        <text class="wm-qr-tip">长按上方二维码，直接识别添加顾问微信</text>
      </view>

      <view class="wm-id-box">
        <text class="wm-id-label">专属顾问微信号</text>
        <text class="wm-id-val">{{activeCard.wechat}}</text>
        <text class="wm-note">{{activeCard.wechatNote}}</text>
      </view>

      <view class="wm-btns">
        <view class="wm-btn cancel" bindtap="closeWechatModal">关闭</view>
        <view class="wm-btn confirm" bindtap="copyWechatId">一键复制微信号</view>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗：顾问快捷编辑宣传单与名片（免发版云端更新） ==================== -->
  <view class="modal-mask" wx:if="{{editModalVisible}}" bindtap="closeEditModal">
    <view class="modal-box edit-box" catchtap="preventBubble">
      <text class="em-title">编辑宣传单与名片（保存即同步云端）</text>
      <scroll-view class="em-scroll" scroll-y="true">
        <view class="ef-group">
          <text class="ef-label">宣传单主标题 *</text>
          <input class="ef-input" value="{{editForm.title}}" bindinput="onEditTitle" />
        </view>
        <view class="ef-group">
          <text class="ef-label">名片展示名称 *</text>
          <input class="ef-input" value="{{editForm.brandName}}" bindinput="onEditBrandName" />
        </view>
        <view class="ef-group">
          <text class="ef-label">名片一句话简介</text>
          <input class="ef-input" value="{{editForm.tagline}}" bindinput="onEditTagline" />
        </view>
        <view class="ef-row">
          <view class="ef-group half">
            <text class="ef-label">联系电话</text>
            <input class="ef-input" value="{{editForm.phone}}" bindinput="onEditPhone" />
          </view>
          <view class="ef-group half">
            <text class="ef-label">顾问微信号</text>
            <input class="ef-input" value="{{editForm.wechat}}" bindinput="onEditWechat" />
          </view>
        </view>

        <view class="ef-group">
          <text class="ef-label">顾问微信二维码（免发版云端换图）</text>
          <view class="qr-upload-row">
            <image class="qr-thumb" wx:if="{{editForm.wechatQr}}" src="{{editForm.wechatQr}}" mode="aspectFill"></image>
            <view class="qr-empty" wx:else>暂无图片</view>
            <view class="qr-upload-btns">
              <text class="qr-u-btn" bindtap="uploadWechatQr">{{editForm.wechatQr ? '更换二维码图' : '+ 从相册上传二维码'}}</text>
              <text class="qr-u-btn clear" wx:if="{{editForm.wechatQr}}" bindtap="clearWechatQr">清除</text>
            </view>
          </view>
        </view>

        <view class="ef-group">
          <text class="ef-label">开篇欢迎导语</text>
          <textarea class="ef-textarea small" value="{{editForm.greeting}}" bindinput="onEditGreeting"></textarea>
        </view>
        <view class="ef-group">
          <text class="ef-label">一、关于我们（正文）</text>
          <textarea class="ef-textarea" value="{{editForm.aboutContent}}" bindinput="onEditAbout"></textarea>
        </view>
      </scroll-view>
      <view class="wm-btns">
        <view class="wm-btn cancel" bindtap="closeEditModal">取消</view>
        <view class="wm-btn confirm" bindtap="saveBrochureEdit">保存并同步云端</view>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗：📊 访客与转发雷达 ==================== -->
  <view class="modal-mask" wx:if="{{visitorModalVisible}}" bindtap="closeVisitorModal">
    <view class="modal-box radar-box" catchtap="preventBubble">
      <view class="radar-head">
        <view>
          <text class="em-title">📊 电子宣传单访客与转发雷达</text>
          <text class="radar-source">{{visitorSource === 'cloud' ? '☁️ 云端全网实时追踪（按 OpenID 与账号识别）' : '📱 本地缓存演示（部署 consultApi 云函数后显示全网访客）'}}</text>
        </view>
        <text class="radar-refresh" bindtap="refreshVisitors">刷新</text>
      </view>

      <view class="radar-kpi-grid">
        <view class="rk-cell">
          <text class="rk-num">{{visitorStats.totalVisitors}}</text>
          <text class="rk-lbl">独立访客</text>
        </view>
        <view class="rk-cell">
          <text class="rk-num">{{visitorStats.totalViews}}</text>
          <text class="rk-lbl">累计浏览</text>
        </view>
        <view class="rk-cell">
          <text class="rk-num">{{visitorStats.totalShares}}</text>
          <text class="rk-lbl">转发次数</text>
        </view>
        <view class="rk-cell">
          <text class="rk-num hot">{{visitorStats.totalLeads}}</text>
          <text class="rk-lbl">加微/拨号意向</text>
        </view>
      </view>

      <scroll-view class="radar-scroll" scroll-y="true">
        <view class="radar-empty" wx:if="{{visitorList.length === 0}}">
          暂无访客记录，转发给好友或打开页面后即可实时捕捉
        </view>
        <view class="radar-item" wx:for="{{visitorList}}" wx:key="openid">
          <view class="ri-top">
            <view class="ri-name-wrap">
              <text class="ri-name">{{item.viewerName}}</text>
              <text class="ri-acc" wx:if="{{item.viewerAccount}}">账号: {{item.viewerAccount}}</text>
            </view>
            <text class="ri-time">{{item.lastVisitTime}}</text>
          </view>
          <view class="ri-tags">
            <text class="ri-tag">看过 {{item.viewCount}} 次</text>
            <text class="ri-tag share" wx:if="{{item.shareCount > 0}}">转发 {{item.shareCount}} 次</text>
            <text class="ri-tag invite" wx:if="{{item.inviteCount > 0}}">带来 {{item.inviteCount}} 位新客</text>
            <text class="ri-tag lead" wx:if="{{item.wechatClickCount > 0 || item.phoneClickCount > 0}}">点过加微/拨号</text>
          </view>
        </view>
      </scroll-view>

      <view class="wm-btns">
        <view class="wm-btn confirm" bindtap="closeVisitorModal">关闭雷达</view>
      </view>
    </view>
  </view>
</view>
