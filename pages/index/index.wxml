<!-- pages/index/index.wxml -->
<view class="index-container">
  <!-- 顶部奢华暖金渐变背景装饰 -->
  <view class="header-glow"></view>

  <!-- 已进入具体导师工作室时，顶部显示轻量工作室位置条 -->
  <view class="studio-context-strip" wx:if="{{!brand.isPlatformDefault}}">
    <text class="scs-name">📍 {{brand.navTitle}}</text>
    <text class="scs-exit" wx:if="{{auth.role !== 'admin'}}" bindtap="exitCurrentStudio">返回臻言广场 ›</text>
  </view>

  <!-- 品牌主标题（平台态展示臻言咨询 Logo，工作室态展示该导师白牌） -->
  <view class="brand-section">
    <image class="brand-logo" wx:if="{{brand.isPlatformDefault}}" src="/images/logo-zhenyan.png" mode="aspectFill"></image>
    <text class="brand-title">{{brand.brandName}}</text>
    <text class="brand-subtitle">{{brand.brandSubtitle}}</text>
  </view>

  <!-- 使命 / 愿景 / 理念 卡片（动态配置） -->
  <view class="value-card luxury-card">
    <view class="value-item">
      <view class="value-label-box">
        <view class="gold-bar"></view>
        <text class="value-label">使命</text>
      </view>
      <text class="value-desc">{{brand.mission}}</text>
    </view>
    <view class="divider"></view>

    <view class="value-item">
      <view class="value-label-box">
        <view class="gold-bar"></view>
        <text class="value-label">愿景</text>
      </view>
      <text class="value-desc">{{brand.vision}}</text>
    </view>
    <view class="divider"></view>

    <view class="value-item">
      <view class="value-label-box">
        <view class="gold-bar"></view>
        <text class="value-label">理念</text>
      </view>
      <text class="value-desc">{{brand.philosophy}}</text>
    </view>
  </view>

  <!-- 电子宣传单与获客名片入口 -->
  <view class="brochure-entry-card" bindtap="goToBrochure">
    <view class="be-left">
      <text class="be-badge">{{brand.isPlatformDefault ? '臻言咨询官方名片' : '工作室电子名片'}}</text>
      <text class="be-title">📖 {{brand.isPlatformDefault ? '臻言咨询 · 平台电子宣传单' : (brand.navTitle + ' · 简介宣传单')}}</text>
      <text class="be-sub">含顾问联系名片与一键转发好友卡片</text>
    </view>
    <view class="be-btn">查看/转发 ›</view>
  </view>

  <!-- 实时进行中的咨询交付空间快捷入口（严格按登录身份 & 工作室隔离） -->
  <!-- 情况1：当前处于臻言咨询平台广场（未进入具体工作室，仅浏览严选导师简介卡片） -->
  <view class="active-portal-card" wx:if="{{brand.isPlatformDefault}}">
    <view class="portal-top">
      <view class="portal-badge-group">
        <text class="portal-live-dot">✦</text>
        <text class="portal-badge-txt">臻言严选顾问团 · 资深商业导师名录</text>
      </view>
      <text class="portal-enter" bindtap="goToRegister">申请入驻 ›</text>
    </view>
    <view class="portal-body">
      <text class="portal-plan">浏览导师履历与代表战绩，按需了解或预约 1V1 深度问诊</text>
      <view class="mentor-showcase-list">
        <view
          class="mentor-showcase-card"
          wx:for="{{mentorsList}}"
          wx:key="tenantId"
          bindtap="viewMentorProfile"
          data-id="{{item.tenantId}}">
          <view class="msc-top">
            <image class="msc-avatar" src="/images/avatar.png" mode="aspectFill"></image>
            <view class="msc-main">
              <view class="msc-name-row">
                <text class="msc-name">{{item.mentorName}}</text>
                <text class="msc-badge">{{item.mentorBadge}}</text>
              </view>
              <text class="msc-studio">{{item.studioName}}</text>
              <text class="msc-title" wx:if="{{item.mentorTitle}}">{{item.mentorTitle}}</text>
            </view>
          </view>
          <view class="msc-bottom">
            <text class="msc-stat" wx:if="{{item.stat1Num}}">{{item.stat1Num}} {{item.stat1Tag}}</text>
            <text class="msc-link">查看简介 ›</text>
          </view>
        </view>
      </view>
    </view>
    <view class="portal-actions">
      <view class="portal-btn primary" bindtap="openConsultModal">预约 1V1 深度问诊</view>
      <view class="portal-btn secondary" bindtap="goToRegister">✨ 入驻开通工作室</view>
    </view>
  </view>

  <!-- 情况2：已登录且有所属工作室项目 -->
  <view class="active-portal-card" wx:elif="{{auth.role !== 'guest' && latestProject}}">
    <view class="portal-top" bindtap="goToLatestProject">
      <view class="portal-badge-group">
        <text class="portal-live-dot">●</text>
        <text class="portal-badge-txt">{{auth.role === 'admin' ? '顾问管理视角' : '我的专属咨询交付空间'}} · {{latestProject.status}}</text>
      </view>
      <text class="portal-enter">进入空间 ›</text>
    </view>
    <view class="portal-body" bindtap="goToLatestProject">
      <text class="portal-plan">{{latestProject.type}}（{{latestProject.name}}）</text>
      <view class="portal-meta-row">
        <text class="portal-meta-tag">当前进度：{{latestProject.stepName}} ({{latestProject.currentStep}}/5)</text>
        <text class="portal-meta-tag">已记录 {{latestProject.sessions.length}} 次咨询</text>
        <text class="portal-meta-tag">{{latestProject.deliverables.length}} 份交付成果</text>
      </view>
    </view>
    <view class="portal-actions">
      <view class="portal-btn primary" bindtap="goToLatestProject">查看咨询过程与交付结果</view>
      <view class="portal-btn secondary" wx:if="{{auth.role === 'admin'}}" bindtap="goToAdmin">顾问录入工作台</view>
    </view>
  </view>

  <!-- 服务对比区域 -->
  <view class="comparison-section">
    <view class="section-header">
      <text class="section-title">服务对比</text>
      <view class="section-indicator"></view>
    </view>

    <!-- 错层堆叠对比卡片容器 -->
    <view class="contrast-wrapper">
      <!-- 左侧底层：服务前卡片 -->
      <view class="before-card">
        <text class="before-title">服务前</text>
        <view class="before-items">
          <text class="before-text">客单低</text>
          <text class="before-text">很辛苦</text>
          <text class="before-text">不赚钱</text>
        </view>
      </view>

      <!-- 右侧浮层：服务后卡片 -->
      <view class="after-card">
        <text class="after-title">服务后</text>

        <view class="service-features">
          <!-- 特性 1：亿万营销 -->
          <view class="feature-row">
            <view class="icon-circle">
              <image class="icon-img" src="/images/icons/car.png" mode="aspectFit"></image>
            </view>
            <view class="feature-content">
              <text class="feature-title">亿万营销</text>
              <text class="feature-desc">高客单的销售体系打造</text>
            </view>
          </view>

          <!-- 特性 2：奢侈品全案 -->
          <view class="feature-row">
            <view class="icon-circle">
              <image class="icon-img" src="/images/icons/plane.png" mode="aspectFit"></image>
            </view>
            <view class="feature-content">
              <text class="feature-title">奢侈品全案</text>
              <text class="feature-desc">10倍利润商业模式操盘</text>
            </view>
          </view>

          <!-- 特性 3：战略股东 -->
          <view class="feature-row">
            <view class="icon-circle">
              <image class="icon-img" src="/images/icons/bell.png" mode="aspectFit"></image>
            </view>
            <view class="feature-content">
              <text class="feature-title">战略股东</text>
              <text class="feature-desc">千万级组织搭建和运作</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 导师背书与认知专栏（仅在进入具体导师工作室后展示，平台中性态不展示个人头像） -->
  <view class="mentor-section luxury-card" wx:if="{{!brand.isPlatformDefault}}">
    <view class="mentor-header">
      <image class="mentor-avatar" src="/images/avatar.png" mode="aspectFill"></image>
      <view class="mentor-meta">
        <view class="mentor-name-tag">
          <text class="mentor-name">{{brand.mentorName}}</text>
          <text class="mentor-badge">{{brand.mentorBadge}}</text>
        </view>
        <text class="mentor-motto">{{brand.mentorMotto}}</text>
      </view>
    </view>
    <view class="mentor-stats">
      <view class="stat-col">
        <text class="stat-num">{{brand.stat1Num}}</text>
        <text class="stat-tag">{{brand.stat1Tag}}</text>
      </view>
      <view class="stat-line"></view>
      <view class="stat-col">
        <text class="stat-num">{{brand.stat2Num}}</text>
        <text class="stat-tag">{{brand.stat2Tag}}</text>
      </view>
      <view class="stat-line"></view>
      <view class="stat-col">
        <text class="stat-num">{{brand.stat3Num}}</text>
        <text class="stat-tag">{{brand.stat3Tag}}</text>
      </view>
    </view>
  </view>

  <!-- 底部预约咨询引导 -->
  <view class="cta-banner">
    <view class="cta-text-wrap">
      <text class="cta-main">打破低客单内卷，重构你的商业底盘</text>
      <text class="cta-sub">仅限创始人 / 转型期企业主 / 高净值IP申请</text>
    </view>
    <button class="gold-btn" bindtap="openConsultModal">预约 1V1 深度问诊</button>
  </view>

  <!-- 弹窗：预约咨询登记 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeConsultModal">
    <view class="modal-box" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">预约 1V1 商业闭门咨询</text>
        <view class="modal-close" bindtap="closeConsultModal">×</view>
      </view>
      <view class="modal-body">
        <text class="modal-tip">请留下您的联系方式与企业现状，{{brand.isPlatformDefault ? '臻言咨询严选导师团队' : brand.mentorName + '团队'}}将在 24 小时内与您初步沟通并安排深度问诊。</text>
        <picker
          wx:if="{{brand.isPlatformDefault && mentorPickerOptions.length > 0}}"
          range="{{mentorPickerOptions}}"
          value="{{selectedMentorIndex}}"
          bindchange="onMentorPickChange">
          <view class="modal-picker">
            <text class="mp-label">意向咨询导师 / 赛道</text>
            <text class="mp-val">{{mentorPickerOptions[selectedMentorIndex]}} ▼</text>
          </view>
        </picker>
        <input class="modal-input" placeholder="您的姓名 / 称呼" value="{{form.name}}" bindinput="onInputName" />
        <input class="modal-input" type="number" placeholder="联系电话 / 微信" value="{{form.phone}}" bindinput="onInputPhone" />
        <input class="modal-input" placeholder="当前所在行业 / 经营项目" value="{{form.industry}}" bindinput="onInputIndustry" />
        <textarea class="modal-textarea" placeholder="当前面临的核心商业卡点（选填）" value="{{form.problem}}" bindinput="onInputProblem"></textarea>
      </view>
      <view class="modal-footer">
        <button class="gold-btn" bindtap="submitAppointment">提交意向申请</button>
      </view>
    </view>
  </view>
</view>
