/* pages/platform/platform.wxss */
.pf-guard {
  min-height: 100vh;
  background: #F8F6F2;
  padding: 80rpx 36rpx;
  box-sizing: border-box;
}

.guard-card {
  background: #FFFFFF;
  padding: 50rpx 36rpx;
  text-align: center;
}

.guard-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.guard-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 12rpx;
}

.guard-sub {
  display: block;
  font-size: 24rpx;
  color: #7D736A;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.guard-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.full-btn {
  width: 100%;
}

.pf-page {
  min-height: 100vh;
  background: #F8F6F2;
  padding-bottom: 80rpx;
}

.pf-header {
  background: linear-gradient(160deg, #141110 0%, #2E241D 100%);
  padding: 28rpx 32rpx 36rpx 32rpx;
}

.pf-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pf-badge {
  font-size: 20rpx;
  color: #E2B678;
  letter-spacing: 2rpx;
}

.pf-logout {
  font-size: 22rpx;
  color: #D8C7B4;
  border: 1rpx solid rgba(216, 199, 180, 0.4);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.pf-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #FFF7EB;
  margin: 14rpx 0 26rpx 0;
}

.pf-kpis {
  display: flex;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.kpi {
  flex: 1;
  text-align: center;
}

.kpi-n {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #E2B678;
}

.kpi-t {
  display: block;
  font-size: 20rpx;
  color: #C7B9A8;
  margin-top: 4rpx;
}

.pf-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EAE1D5;
}

.pf-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 26rpx;
  color: #7D736A;
  border-bottom: 6rpx solid transparent;
}

.pf-tab.active {
  color: #8D6238;
  font-weight: 600;
  border-bottom-color: #8D6238;
}

.pf-body {
  padding: 28rpx 32rpx;
}

.tenant-card {
  background: #FFFFFF;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.tc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.tc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
}

.tc-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.tc-status.ok {
  background: #E9F5EB;
  color: #2E6F3A;
}

.tc-status.warn {
  background: #FFF3E0;
  color: #B86B14;
}

.tc-status.bad {
  background: #FCE8E6;
  color: #B3261E;
}

.tc-line {
  display: block;
  font-size: 24rpx;
  color: #5C534A;
  line-height: 1.6;
}

.tc-id {
  display: block;
  font-size: 20rpx;
  color: #A39688;
  margin-top: 6rpx;
}

.tc-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0EAE1;
}

.tc-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 12rpx 0;
  border-radius: 24rpx;
  border: 1rpx solid #D5C3AE;
  color: #5C4A3A;
}

.tc-btn.gold {
  background: #8D6238;
  border-color: #8D6238;
  color: #FFFFFF;
}

.tc-btn.danger {
  border-color: #E3B5B0;
  color: #B3261E;
}

.tc-copy {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8D6238;
  text-align: center;
}

.panel-card {
  background: #FFFFFF;
  padding: 36rpx 32rpx;
}

.panel-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 8rpx;
}

.panel-sub {
  display: block;
  font-size: 22rpx;
  color: #8C8074;
  line-height: 1.5;
  margin-bottom: 26rpx;
}

.f-group {
  margin-bottom: 22rpx;
}

.f-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #3A312A;
  margin-bottom: 10rpx;
}

.f-input,
.f-picker {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
}
