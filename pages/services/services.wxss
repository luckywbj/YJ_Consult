/* pages/services/services.wxss */
.services-container {
  padding: 30rpx 32rpx 100rpx 32rpx;
  background-color: #F8F6F2;
}

.page-header {
  text-align: center;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 500;
  color: #241E1A;
  letter-spacing: 8rpx;
}

.page-subtitle {
  font-size: 22rpx;
  color: #8C8074;
  margin-top: 10rpx;
  display: block;
}

/* 服务方案卡片 */
.products-list {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  margin-bottom: 50rpx;
}

.service-card {
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  position: relative;
  transition: all 0.2s ease;
}

.service-card.selected {
  border: 2rpx solid #8D6238;
}

.service-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.tier-name {
  font-size: 22rpx;
  color: #8D6238;
  background: #F7EFE5;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.quota-text {
  font-size: 22rpx;
  color: #A09386;
}

.service-name {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 12rpx;
}

.service-target {
  display: block;
  font-size: 24rpx;
  color: #7D736A;
  margin-bottom: 24rpx;
}

/* 价格横幅 */
.price-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(90deg, #FDFBF8 0%, #F6EFE6 100%);
  border: 1rpx solid #E8DCCB;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 20rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price-label {
  font-size: 22rpx;
  color: #7D736A;
}

.price-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #8D6238;
}

.deposit-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #241E1A;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 数字化交付保障提示 */
.digital-guarantee {
  display: flex;
  align-items: flex-start;
  background: #F9F7F3;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.dg-icon {
  color: #B88B4A;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.dg-text {
  font-size: 22rpx;
  color: #6E6257;
  line-height: 1.4;
}

.card-action-bar.two-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.plan-btn-half {
  flex: 1;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.service-divider {
  height: 1rpx;
  background: #F0ECE4;
  margin-bottom: 24rpx;
}

.deliverables-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.del-item {
  display: flex;
  align-items: flex-start;
}

.del-icon {
  color: #8D6238;
  font-size: 24rpx;
  margin-right: 14rpx;
  font-weight: bold;
}

.del-text {
  font-size: 26rpx;
  color: #4A413A;
  line-height: 1.5;
}

.card-action-bar {
  margin-top: 10rpx;
}

.plan-btn {
  width: 100%;
}

/* 交付流程 */
.process-section {
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  margin-bottom: 50rpx;
}

.process-title-box {
  text-align: center;
  margin-bottom: 36rpx;
}

.process-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #241E1A;
}

.process-sub {
  display: block;
  font-size: 22rpx;
  color: #8D8277;
  margin-top: 8rpx;
}

.steps-wrapper {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.step-node {
  display: flex;
  align-items: flex-start;
}

.step-num {
  width: 52rpx;
  height: 52rpx;
  background: #8D6238;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.step-info {
  flex: 1;
}

.step-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2723;
  margin-bottom: 4rpx;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: #7A7067;
  line-height: 1.4;
}

/* 预约表单 */
.appointment-form-card {
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  margin-bottom: 40rpx;
}

.form-header {
  margin-bottom: 30rpx;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 8rpx;
}

.form-tip {
  display: block;
  font-size: 22rpx;
  color: #8C8074;
  line-height: 1.4;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #38312B;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-picker {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.highlight-picker {
  border-color: #C7AD8E;
  background: #FCF9F4;
}

.picker-main-text {
  font-weight: 600;
  color: #241E1A;
}

.picker-price-tag {
  font-size: 24rpx;
  color: #8D6238;
  font-weight: 600;
}

/* 下单模式选择器 */
.pay-mode-selector {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pay-mode-item {
  border: 2rpx solid #E6DDD0;
  background: #FAF8F5;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  transition: all 0.2s ease;
}

.pay-mode-item.active {
  border-color: #8D6238;
  background: #FDF9F3;
  box-shadow: 0 6rpx 18rpx rgba(141, 98, 56, 0.1);
}

.pm-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.pm-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #241E1A;
}

.pm-badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #8D6238;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.pm-price {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #8D6238;
  margin-bottom: 4rpx;
}

.pm-desc {
  display: block;
  font-size: 22rpx;
  color: #7D736A;
}

.form-row-two {
  display: flex;
  gap: 20rpx;
}

.form-group.half {
  flex: 1;
}

.form-textarea {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  height: 160rpx;
  width: 100%;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  margin-top: 20rpx;
}

/* 底部联系条 */
.footer-contact {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #241E1A;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 30rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-icon {
  font-size: 32rpx;
}

.contact-text {
  font-size: 26rpx;
  color: #EBDCCB;
  letter-spacing: 1rpx;
}

.contact-divider {
  width: 1rpx;
  height: 36rpx;
  background: #473E37;
}
