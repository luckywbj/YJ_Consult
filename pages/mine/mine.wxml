<!-- pages/mine/mine.wxml -->
<view class="container mine-container">
  <!-- 顶部身份与登录状态卡片（始终展示当前权限与「客户手机号登录 / 顾问后台登录」切换按钮） -->
  <view class="auth-status-card luxury-card">
    <!-- 状态 1：未登录访客 -->
    <view class="auth-row" wx:if="{{auth.role === 'guest'}}">
      <view class="auth-avatar guest">🔒</view>
      <view class="auth-info">
        <view class="auth-name-line">
          <text class="auth-title">当前权限：未登录访客</text>
        </view>
        <text class="auth-desc">为保护客户商业机密，登录后方可查阅专属咨询过程与交付方案</text>
      </view>
    </view>

    <!-- 状态 2：已登录客户（仅看自己项目） -->
    <view class="auth-row" wx:elif="{{auth.role === 'client'}}">
      <view class="auth-avatar client">VIP</view>
      <view class="auth-info">
        <view class="auth-name-line">
          <text class="auth-title">{{auth.clientName}}</text>
          <text class="role-pill client">当前权限：签约客户</text>
        </view>
        <text class="auth-desc">登录手机号：{{auth.clientPhone}}（仅显示您本人的咨询项目）</text>
      </view>
      <view class="logout-link" bindtap="handleLogout">退出</view>
    </view>

    <!-- 状态 3：已登录顾问/后台工作人员 -->
    <view class="auth-row" wx:elif="{{auth.role === 'admin'}}">
      <image class="avatar-img small" src="/images/avatar.png" mode="aspectFill"></image>
      <view class="auth-info">
        <view class="auth-name-line">
          <text class="auth-title">{{auth.staffName}}</text>
          <text class="role-pill admin">当前权限：顾问后台</text>
        </view>
        <text class="auth-desc">可查阅并录入全部客户的咨询过程与交付结果</text>
      </view>
      <view class="logout-link" bindtap="handleLogout">退出</view>
    </view>

    <!-- 未登录时显示统一的账号登录入口 -->
    <view class="auth-btn-group" wx:if="{{auth.role === 'guest'}}">
      <view class="auth-action-btn primary" bindtap="openLoginModal" data-mode="client">
        👤 客户账号登录
      </view>
      <view class="auth-action-btn admin-outline" bindtap="openLoginModal" data-mode="admin">
        🛠️ 顾问后台登录
      </view>
    </view>
    <view class="top-order-link" wx:if="{{auth.role === 'guest'}}" bindtap="goToServices">
      尚未立项？前往「服务」页在线下单 ›
    </view>
  </view>

  <!-- 顾问端工作台入口卡片（仅在顾问后台登录 role === 'admin' 时显示，客户完全不可见！） -->
  <view class="workspace-banner" wx:if="{{auth.role === 'admin'}}" bindtap="openAdminWorkspace">
    <view class="wb-left">
      <view class="wb-tag-row">
        <text class="wb-badge">内部专用</text>
        <text class="wb-title">岩姐顾问录入工作台</text>
      </view>
      <text class="wb-desc">为客户建档立项、录入每次咨询过程、派发行动清单、上传交付方案与更新战果</text>
    </view>
    <view class="wb-btn">进入工作台 ›</view>
  </view>

  <!-- 我的咨询项目与交付空间（仅登录后展示，避免与顶部登录入口重复） -->
  <view class="section-block luxury-card" wx:if="{{auth.role !== 'guest'}}">
    <view class="block-header">
      <text class="block-title">{{auth.role === 'admin' ? '全部客户咨询项目档案' : '我的专属咨询交付空间'}}</text>
      <text class="record-count">共 {{appointments.length}} 个项目</text>
    </view>

    <!-- 已登录且有可见项目 -->
    <view class="appointment-list" wx:if="{{appointments.length > 0}}">
      <view 
        class="appointment-item" 
        wx:for="{{appointments}}" 
        wx:key="id"
        bindtap="openProjectSpace"
        data-id="{{item.id}}"
        data-tab="0">
        
        <view class="item-top">
          <text class="item-type">{{item.type}}</text>
          <text class="item-status {{item.status === '已交付结案' ? 'done' : ''}}">{{item.status}}</text>
        </view>

        <view class="item-detail">
          <text class="detail-line">项目编号：{{item.id}} · {{item.payMode}}</text>
          <text class="detail-line">专属客户：{{item.name}}（{{item.industry}} · {{item.phone}}）</text>
          <text class="detail-line milestone">当前阶段：{{item.stepName}} ({{item.currentStep}}/5)</text>
        </view>

        <!-- 咨询过程与交付统计标签 -->
        <view class="item-stats-bar">
          <text class="stat-pill">📋 {{item.sessions ? item.sessions.length : 0}} 次咨询过程记录</text>
          <text class="stat-pill">📄 {{item.deliverables ? item.deliverables.length : 0}} 份阶段交付成果</text>
          <text class="stat-pill">📈 战果：{{item.metrics ? item.metrics.ticketAfter : '推进中'}}</text>
        </view>

        <!-- 快捷操作按钮 -->
        <view class="item-actions">
          <view class="act-btn outline" catchtap="openProjectSpace" data-id="{{item.id}}" data-tab="0">
            咨询记录与反馈
          </view>
          <view class="act-btn primary" catchtap="openProjectSpace" data-id="{{item.id}}" data-tab="1">
            查看交付结果看板
          </view>
        </view>
      </view>
    </view>

    <!-- 已登录但暂无项目 -->
    <view class="empty-tip" wx:else>
      <text>当前账号下暂无咨询项目，可前往“服务”页在线下单立项</text>
    </view>
  </view>

  <!-- 首席顾问 IP 名片 -->
  <view class="profile-card luxury-card">
    <view class="profile-top">
      <image class="avatar-img" src="/images/avatar.png" mode="aspectFill"></image>
      <view class="profile-main">
        <view class="name-row">
          <text class="user-name">岩姐</text>
          <text class="identity-tag">首席操盘顾问</text>
        </view>
        <text class="user-title">高客单商业操盘手 · 奢侈品思维导师</text>
      </view>
    </view>
    <text class="slogan-line">“所有行业都值得用奢侈品思维重做一遍”</text>

    <view class="kpi-grid">
      <view class="kpi-cell">
        <text class="kpi-num">300+</text>
        <text class="kpi-txt">高净值企业私董</text>
      </view>
      <view class="kpi-split"></view>
      <view class="kpi-cell">
        <text class="kpi-num">10+年</text>
        <text class="kpi-txt">商业操盘战历</text>
      </view>
      <view class="kpi-split"></view>
      <view class="kpi-cell">
        <text class="kpi-num">8.6x</text>
        <text class="kpi-txt">客户平均客单提升</text>
      </view>
    </view>
  </view>

  <!-- 官方服务与联系 -->
  <view class="menu-group luxury-card">
    <view class="menu-row" bindtap="openBrochure">
      <view class="menu-left">
        <text class="menu-icon">📖</text>
        <text class="menu-label">公司简介电子宣传单</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">查看 / 一键转发</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="copyWechat">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-label">官方微信咨询</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">yanjie_consulting</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="callHotline">
      <view class="menu-left">
        <text class="menu-icon">📞</text>
        <text class="menu-label">VIP 咨询专线</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">400-880-9966</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider" wx:if="{{auth.role === 'client'}}"></view>

    <view class="menu-row" bindtap="openLoginModal" data-mode="admin" wx:if="{{auth.role === 'client'}}">
      <view class="menu-left">
        <text class="menu-icon">🔐</text>
        <text class="menu-label">内部顾问工作人员入口</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">口令验证</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider" wx:if="{{auth.role === 'admin'}}"></view>

    <view class="menu-row" bindtap="openAccountManager" wx:if="{{auth.role === 'admin'}}">
      <view class="menu-left">
        <text class="menu-icon">👥</text>
        <text class="menu-label">账号管理</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">顾问团队与客户账号</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider" wx:if="{{auth.role !== 'guest'}}"></view>

    <view class="menu-row" bindtap="openChangePassModal" wx:if="{{auth.role !== 'guest'}}">
      <view class="menu-left">
        <text class="menu-icon">🔑</text>
        <text class="menu-label">修改我的登录密码</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">保护隐私安全</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider" wx:if="{{auth.role === 'admin'}}"></view>

    <view class="menu-row" bindtap="resetDemo" wx:if="{{auth.role === 'admin'}}">
      <view class="menu-left">
        <text class="menu-icon">🔄</text>
        <text class="menu-label">恢复初始演示项目数据</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">一键重置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 常见问题 FAQ -->
  <view class="faq-block luxury-card">
    <text class="faq-title">常 见 问 题 (FAQ)</text>
    <view class="faq-list">
      <view class="faq-item" wx:for="{{faqList}}" wx:key="q" bindtap="toggleFaq" data-index="{{index}}">
        <view class="faq-q-row">
          <text class="faq-q">{{item.q}}</text>
          <text class="faq-arrow">{{item.open ? '−' : '+'}}</text>
        </view>
        <text class="faq-a" wx:if="{{item.open}}">{{item.a}}</text>
      </view>
    </view>
  </view>

  <!-- 版权信息 -->
  <view class="copyright-bar">
    <text>岩值商业咨询 · 版权所有</text>
    <text class="copyright-en">YANZHI CONSULTING © 2026 ALL RIGHTS RESERVED</text>
  </view>

  <!-- ==================== 弹窗：客户登录 / 顾问后台登录 ==================== -->
  <view class="login-mask" wx:if="{{loginModal.visible}}" bindtap="closeLoginModal">
    <view class="login-box" catchtap="preventBubble">
      <!-- 登录角色切换 Tab -->
      <view class="login-tabs">
        <view 
          class="l-tab {{loginModal.mode === 'client' ? 'active' : ''}}" 
          bindtap="switchLoginMode" 
          data-mode="client">
          客户手机号登录
        </view>
        <view 
          class="l-tab {{loginModal.mode === 'admin' ? 'active' : ''}}" 
          bindtap="switchLoginMode" 
          data-mode="admin">
          顾问后台登录
        </view>
      </view>

      <!-- 模式 A：客户手机号登录 -->
      <view class="login-body" wx:if="{{loginModal.mode === 'client'}}">
        <text class="login-tip">请输入顾问为您开通的手机号与专属登录密码（忘记密码请联系顾问在后台重置）：</text>
        <input 
          class="login-input" 
          type="number" 
          placeholder="请输入客户手机号" 
          value="{{loginModal.phone}}" 
          bindinput="onLoginPhoneInput" />
        <input 
          class="login-input" 
          password="true"
          placeholder="请输入专属登录密码" 
          value="{{loginModal.code}}" 
          bindinput="onLoginCodeInput" />

        <!-- 快捷体验测试账号（方便演示不同客户之间的数据完全隔离） -->
        <view class="demo-accounts-box">
          <text class="da-label">⚡ 点击下方演示客户账号可一键填入测试（默认密码为手机号后6位）：</text>
          <view class="da-pills">
            <view class="da-pill" bindtap="quickFillClient" data-phone="13888888899">
              客户1：李总 (13888888899 · 密码 888899)
            </view>
            <view class="da-pill" bindtap="quickFillClient" data-phone="13988885520">
              客户2：陈老师 (13988885520 · 密码 885520)
            </view>
          </view>
        </view>

        <button class="gold-btn login-submit-btn" bindtap="submitClientLogin">验证并进入我的交付空间</button>
      </view>

      <!-- 模式 B：顾问/后台工作人员登录 -->
      <view class="login-body" wx:if="{{loginModal.mode === 'admin'}}">
        <text class="login-tip">仅限岩值咨询顾问团队及后台助教人员登录。请输入顾问账号与专属密码：</text>
        <input 
          class="login-input" 
          placeholder="请输入顾问登录账号（如：yanjie）" 
          value="{{loginModal.adminUser}}" 
          bindinput="onAdminUserInput" />
        <input 
          class="login-input" 
          password="true" 
          placeholder="请输入顾问登录密码" 
          value="{{loginModal.adminPass}}" 
          bindinput="onAdminPassInput" />
        <view class="demo-accounts-box">
          <text class="da-label">⚡ 点击下方演示顾问账号可一键填入测试：</text>
          <view class="da-pills">
            <view class="da-pill" bindtap="quickFillAdmin" data-user="yanjie">
              主管理员：岩姐 (yanjie · 密码 888888)
            </view>
            <view class="da-pill" bindtap="quickFillAdmin" data-user="assistant">
              交付助教：林助教 (assistant · 密码 666666)
            </view>
          </view>
        </view>
        <button class="gold-btn login-submit-btn" bindtap="submitAdminLogin">验证并解锁顾问工作台</button>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗：自助修改登录密码 ==================== -->
  <view class="login-mask" wx:if="{{changePassModal.visible}}" bindtap="closeChangePassModal">
    <view class="login-box cp-box" catchtap="preventBubble">
      <text class="cp-title">修改登录密码</text>
      <text class="cp-sub">当前账号：{{auth.role === 'admin' ? auth.staffUsername : auth.clientPhone}}（修改后请妥善保管新密码）</text>
      <input
        class="login-input"
        password="true"
        placeholder="请输入原登录密码"
        value="{{changePassModal.oldPass}}"
        bindinput="onOldPassInput" />
      <input
        class="login-input"
        password="true"
        placeholder="请输入新密码（至少4位）"
        value="{{changePassModal.newPass}}"
        bindinput="onNewPassInput" />
      <input
        class="login-input"
        password="true"
        placeholder="请再次确认新密码"
        value="{{changePassModal.confirmPass}}"
        bindinput="onConfirmPassInput" />
      <view class="cp-btns">
        <view class="cp-btn cancel" bindtap="closeChangePassModal">取消</view>
        <view class="cp-btn confirm" bindtap="submitChangePassword">确认修改</view>
      </view>
    </view>
  </view>
</view>
