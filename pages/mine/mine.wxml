<!-- pages/mine/mine.wxml -->
<view class="container mine-container">
  <!-- 顶部身份与登录状态卡片（始终展示当前权限与「客户手机号登录 / 顾问后台登录」切换按钮） -->
  <view class="auth-status-card luxury-card">
    <!-- 状态 1：未登录访客 -->
    <view class="auth-row" wx:if="{{auth.role === 'guest'}}">
      <view class="auth-avatar guest">🔒</view>
      <view class="auth-info">
        <view class="auth-name-line">
          <text class="auth-title">当前权限：未登录访客</text>
        </view>
        <text class="auth-desc">为保护客户商业机密，登录后方可查阅专属咨询过程与交付方案</text>
      </view>
    </view>

    <!-- 状态 2：已登录客户（仅看自己项目） -->
    <view class="auth-row" wx:elif="{{auth.role === 'client'}}">
      <view class="auth-avatar client">VIP</view>
      <view class="auth-info">
        <view class="auth-name-line">
          <text class="auth-title">{{auth.clientName}}</text>
          <text class="role-pill client">当前权限：签约客户</text>
        </view>
        <text class="auth-desc">登录手机号：{{auth.clientPhone}}（仅显示您本人的咨询项目）</text>
      </view>
      <view class="logout-link" bindtap="handleLogout">退出</view>
    </view>

    <!-- 状态 3：已登录顾问/后台工作人员 -->
    <view class="auth-row" wx:elif="{{auth.role === 'admin'}}">
      <image class="avatar-img small" src="/images/avatar.png" mode="aspectFill"></image>
      <view class="auth-info">
        <view class="auth-name-line">
          <text class="auth-title">{{auth.staffName}}</text>
          <text class="role-pill admin">当前权限：顾问后台</text>
        </view>
        <text class="auth-desc">仅可查阅并管理本工作室名下的客户档案（与其他导师完全隔离）</text>
      </view>
      <view class="logout-link" bindtap="handleLogout">退出</view>
    </view>

    <!-- 未登录时显示统一的账号登录入口 -->
    <view class="auth-btn-group" wx:if="{{auth.role === 'guest'}}">
      <view class="auth-action-btn primary" bindtap="openLoginModal" data-mode="client">
        👤 客户账号登录
      </view>
      <view class="auth-action-btn admin-outline" bindtap="openLoginModal" data-mode="admin">
        🛠️ 导师工作室登录
      </view>
    </view>
    <view class="top-order-link" wx:if="{{auth.role === 'guest'}}" bindtap="goToServices">
      尚未立项？前往「服务」页在线下单 ›
    </view>
  </view>

  <!-- 当前访问的工作室 + 臻言平台入驻入口 -->
  <view class="studio-strip">
    <text class="ss-txt">{{brand.isPlatformDefault ? '当前位置：臻言咨询平台广场' : ('当前门户：' + brand.navTitle)}}</text>
    <text class="ss-open" bindtap="exitStudioToPlatform" wx:if="{{!brand.isPlatformDefault && auth.role !== 'admin'}}">返回臻言广场 ›</text>
    <text class="ss-open" bindtap="goToRegister" wx:elif="{{brand.isPlatformDefault}}">入驻臻言 ›</text>
  </view>

  <!-- 顾问端工作台入口卡片（仅在顾问后台登录 role === 'admin' 时显示，客户完全不可见！） -->
  <view class="workspace-banner" wx:if="{{auth.role === 'admin'}}">
    <view class="wb-left" bindtap="openAdminWorkspace">
      <view class="wb-tag-row">
        <text class="wb-badge">内部专用</text>
        <text class="wb-title">{{brand.mentorName}}顾问工作台 & 标品装修</text>
      </view>
      <text class="wb-desc">录入咨询过程、发布交付方案、一键切换行业标品母版、改品牌名与套餐定价</text>
      <view class="wb-action-row">
        <view class="wb-btn" catchtap="openAdminWorkspace">📋 录咨询与交付</view>
        <view class="wb-btn gold-solid" catchtap="openBrandConfig">⚙️ 标品品牌装修</view>
      </view>
    </view>
  </view>

  <!-- 我的咨询项目与交付空间（平台态展示双端快捷指引；进入后仅登录后展示项目） -->
  <view class="section-block luxury-card" wx:if="{{brand.isPlatformDefault || auth.role !== 'guest'}}">
    <view class="block-header">
      <text class="block-title">{{brand.isPlatformDefault ? '臻言咨询 · 双端快捷指引' : (auth.role === 'admin' ? '本工作室客户咨询项目档案' : '我的专属咨询交付空间')}}</text>
      <text class="record-count" wx:if="{{auth.role !== 'guest'}}">共 {{appointments.length}} 个项目</text>
    </view>

    <!-- 未进入具体导师工作室时（平台中性态），提供双端清晰入口而不直接暴露他人工作室切入 -->
    <view class="privacy-lock-box" wx:if="{{brand.isPlatformDefault}}">
      <text class="lock-icon">🏛️</text>
      <text class="lock-title">一导师一独立交付系统</text>
      <text class="lock-sub">已签约客户点击上方「客户账号登录」即可凭手机号与密码自动进入所属导师的专属交付空间；导师点击「导师工作室登录」进入独立后台。</text>
      <view class="auth-btn-group">
        <view class="auth-action-btn primary" bindtap="goToHome">🏛️ 去首页看严选导师</view>
        <view class="auth-action-btn admin-outline" bindtap="goToRegister">✨ 10 秒开通我的工作室</view>
      </view>
    </view>

    <!-- 已登录且有可见项目 -->
    <view class="appointment-list" wx:elif="{{appointments.length > 0}}">
      <view 
        class="appointment-item" 
        wx:for="{{appointments}}" 
        wx:key="id"
        bindtap="openProjectSpace"
        data-id="{{item.id}}"
        data-tab="0">
        
        <view class="item-top">
          <text class="item-type">{{item.type}}</text>
          <text class="item-status {{item.status === '已交付结案' ? 'done' : ''}}">{{item.status}}</text>
        </view>

        <view class="item-detail">
          <text class="detail-line">项目编号：{{item.id}} · {{item.payMode}}</text>
          <text class="detail-line">专属客户：{{item.name}}（{{item.industry}} · {{item.phone}}）</text>
          <text class="detail-line milestone">当前阶段：{{item.stepName}} ({{item.currentStep}}/5)</text>
        </view>

        <!-- 咨询过程与交付统计标签 -->
        <view class="item-stats-bar">
          <text class="stat-pill">📋 {{item.sessions ? item.sessions.length : 0}} 次咨询过程记录</text>
          <text class="stat-pill">📄 {{item.deliverables ? item.deliverables.length : 0}} 份阶段交付成果</text>
          <text class="stat-pill">📈 战果：{{item.metrics ? item.metrics.ticketAfter : '推进中'}}</text>
        </view>

        <!-- 快捷操作按钮 -->
        <view class="item-actions">
          <view class="act-btn outline" catchtap="openProjectSpace" data-id="{{item.id}}" data-tab="0">
            咨询记录与反馈
          </view>
          <view class="act-btn primary" catchtap="openProjectSpace" data-id="{{item.id}}" data-tab="1">
            查看交付结果看板
          </view>
        </view>
      </view>
    </view>

    <!-- 已登录但暂无项目 -->
    <view class="empty-tip" wx:else>
      <text>当前账号下暂无咨询项目，可前往“服务”页在线下单立项</text>
    </view>
  </view>

  <!-- 首席顾问 IP 名片（仅在进入具体某位导师的工作室后展示，平台中性态隐藏个人名片） -->
  <view class="profile-card luxury-card" wx:if="{{!brand.isPlatformDefault}}">
    <view class="profile-top">
      <image class="avatar-img" src="/images/avatar.png" mode="aspectFill"></image>
      <view class="profile-main">
        <view class="name-row">
          <text class="user-name">{{brand.mentorName}}</text>
          <text class="identity-tag">{{brand.mentorBadge}}</text>
        </view>
        <text class="user-title">{{brand.mentorTitle}}</text>
      </view>
    </view>
    <text class="slogan-line">“{{brand.philosophy}}”</text>

    <view class="kpi-grid">
      <view class="kpi-cell">
        <text class="kpi-num">{{brand.stat1Num}}</text>
        <text class="kpi-txt">{{brand.stat1Tag}}</text>
      </view>
      <view class="kpi-split"></view>
      <view class="kpi-cell">
        <text class="kpi-num">{{brand.stat2Num}}</text>
        <text class="kpi-txt">{{brand.stat2Tag}}</text>
      </view>
      <view class="kpi-split"></view>
      <view class="kpi-cell">
        <text class="kpi-num">{{brand.stat3Num}}</text>
        <text class="kpi-txt">{{brand.stat3Tag}}</text>
      </view>
    </view>
  </view>

  <!-- 官方服务与联系 -->
  <view class="menu-group luxury-card">
    <view class="menu-row" bindtap="openBrochure">
      <view class="menu-left">
        <text class="menu-icon">📖</text>
        <text class="menu-label">电子宣传单与获客名片</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">查看 / 一键转发</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="copyWechat">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-label">官方微信咨询</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">{{brand.wechat}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="callHotline">
      <view class="menu-left">
        <text class="menu-icon">📞</text>
        <text class="menu-label">VIP 咨询专线</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">{{brand.phone}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="goToRegister">
      <view class="menu-left">
        <text class="menu-icon">✨</text>
        <text class="menu-label">入驻臻言咨询（开通工作室）</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">{{trialDays}}天免费试用</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="goToPlatform">
      <view class="menu-left">
        <text class="menu-icon">🏛️</text>
        <text class="menu-label">臻言平台总控台（平台方专用）</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">开号 / 续费</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider" wx:if="{{auth.role === 'client'}}"></view>

    <view class="menu-row" bindtap="openChangePassModal" wx:if="{{auth.role === 'client'}}">
      <view class="menu-left">
        <text class="menu-icon">🔑</text>
        <text class="menu-label">修改我的登录密码</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">保护隐私安全</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-divider" wx:if="{{auth.role === 'admin'}}"></view>

    <view class="menu-row" bindtap="resetDemo" wx:if="{{auth.role === 'admin'}}">
      <view class="menu-left">
        <text class="menu-icon">🔄</text>
        <text class="menu-label">恢复初始演示项目数据</text>
      </view>
      <view class="menu-right">
        <text class="menu-val">一键重置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 常见问题 FAQ -->
  <view class="faq-block luxury-card">
    <text class="faq-title">常 见 问 题 (FAQ)</text>
    <view class="faq-list">
      <view class="faq-item" wx:for="{{faqList}}" wx:key="q" bindtap="toggleFaq" data-index="{{index}}">
        <view class="faq-q-row">
          <text class="faq-q">{{item.q}}</text>
          <text class="faq-arrow">{{item.open ? '−' : '+'}}</text>
        </view>
        <text class="faq-a" wx:if="{{item.open}}">{{item.a}}</text>
      </view>
    </view>
  </view>

  <!-- 版权信息 -->
  <view class="copyright-bar">
    <text>{{brand.isPlatformDefault ? '臻言咨询 · 商业顾问服务平台' : (brand.navTitle + ' · 臻言咨询入驻工作室')}}</text>
    <text class="copyright-en">{{brand.brandSubtitle}} © 2026</text>
  </view>

  <!-- ==================== 弹窗：客户登录 / 顾问后台登录 ==================== -->
  <view class="login-mask" wx:if="{{loginModal.visible}}" bindtap="closeLoginModal">
    <view class="login-box" catchtap="preventBubble">
      <!-- 登录角色切换 Tab -->
      <view class="login-tabs">
        <view 
          class="l-tab {{loginModal.mode === 'client' ? 'active' : ''}}" 
          bindtap="switchLoginMode" 
          data-mode="client">
          客户手机号登录
        </view>
        <view 
          class="l-tab {{loginModal.mode === 'admin' ? 'active' : ''}}" 
          bindtap="switchLoginMode" 
          data-mode="admin">
          导师工作室登录
        </view>
      </view>

      <!-- 模式 A：客户手机号登录 -->
      <view class="login-body" wx:if="{{loginModal.mode === 'client'}}">
        <text class="login-tip">请输入导师为您开通的手机号与专属登录密码（忘记密码请联系导师重置）：</text>
        <input 
          class="login-input" 
          type="number" 
          placeholder="请输入客户手机号" 
          value="{{loginModal.phone}}" 
          bindinput="onLoginPhoneInput" />
        <input 
          class="login-input" 
          password="true"
          placeholder="请输入专属登录密码" 
          value="{{loginModal.code}}" 
          bindinput="onLoginCodeInput" />

        <!-- 快捷体验测试账号（方便演示不同客户之间的数据完全隔离） -->
        <view class="demo-accounts-box">
          <text class="da-label">{{brand.isPlatformDefault ? '⚡ 演示客户账号（点击自动识别所属导师空间，默认密码手机号后6位）：' : '⚡ 本工作室演示客户账号（默认密码手机号后6位），点击填入：'}}</text>
          <view class="da-pills">
            <view class="da-pill" wx:for="{{demoClients}}" wx:key="phone" bindtap="quickFillClient" data-phone="{{item.phone}}">
              {{item.name}}{{item.studioName ? ' · ' + item.studioName : ''}} ({{item.phone}})
            </view>
            <text class="da-empty" wx:if="{{demoClients.length === 0}}">当前工作室暂无客户项目</text>
          </view>
        </view>

        <button class="gold-btn login-submit-btn" bindtap="submitClientLogin">验证并进入我的交付空间</button>
      </view>

      <!-- 模式 B：导师工作室登录（每位导师一个独立账号） -->
      <view class="login-body" wx:if="{{loginModal.mode === 'admin'}}">
        <text class="login-tip">导师使用自己的工作室账号登录。登录后自动进入自己的工作室，只能管理自己的门户与客户：</text>
        <input
          class="login-input"
          type="number"
          maxlength="11"
          placeholder="工作室登录手机号"
          value="{{loginModal.mentorPhone}}"
          bindinput="onMentorPhoneInput" />
        <input 
          class="login-input" 
          password="true" 
          placeholder="登录密码" 
          value="{{loginModal.adminPass}}" 
          bindinput="onAdminPassInput" />
        <view class="demo-accounts-box">
          <text class="da-label">⚡ 演示工作室账号（密码均为 8888），点击填入：</text>
          <view class="da-pills">
            <view class="da-pill" bindtap="quickFillMentor" data-phone="13800000001">岩姐咨询（13800000001）</view>
            <view class="da-pill" bindtap="quickFillMentor" data-phone="13800000002">卓远财税 · 周远山（13800000002）</view>
            <view class="da-pill" bindtap="quickFillMentor" data-phone="13800000003">东方奢美 · 苏婉清（13800000003）</view>
          </view>
        </view>
        <button class="gold-btn login-submit-btn" bindtap="submitAdminLogin">登录我的工作室</button>
        <view class="register-link" bindtap="goToRegister">还没有工作室？立即开通（免费试用） ›</view>
      </view>
    </view>
  </view>

  <!-- ==================== 弹窗：客户自助修改登录密码 ==================== -->
  <view class="login-mask" wx:if="{{changePassModal.visible}}" bindtap="closeChangePassModal">
    <view class="login-box cp-box" catchtap="preventBubble">
      <text class="cp-title">修改登录密码</text>
      <text class="cp-sub">当前账号：{{auth.clientPhone}}（修改后请妥善保管新密码）</text>
      <input
        class="login-input"
        password="true"
        placeholder="请输入原登录密码"
        value="{{changePassModal.oldPass}}"
        bindinput="onOldPassInput" />
      <input
        class="login-input"
        password="true"
        placeholder="请输入新密码（至少4位）"
        value="{{changePassModal.newPass}}"
        bindinput="onNewPassInput" />
      <input
        class="login-input"
        password="true"
        placeholder="请再次确认新密码"
        value="{{changePassModal.confirmPass}}"
        bindinput="onConfirmPassInput" />
      <view class="cp-btns">
        <view class="cp-btn cancel" bindtap="closeChangePassModal">取消</view>
        <view class="cp-btn confirm" bindtap="submitChangePassword">确认修改</view>
      </view>
    </view>
  </view>
</view>
