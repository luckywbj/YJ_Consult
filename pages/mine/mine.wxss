/* pages/mine/mine.wxss */
.mine-container {
  padding: 30rpx 32rpx 80rpx 32rpx;
  background-color: #F8F6F2;
}

/* 顶部登录与身份卡片 */
.auth-status-card {
  padding: 32rpx;
  background: #FFFFFF;
  margin-bottom: 30rpx;
  border: 1rpx solid #E5D9C8;
}

.auth-row {
  display: flex;
  align-items: center;
}

.auth-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.auth-avatar.guest {
  background: #F4EFE8;
  color: #8D6238;
}

.auth-avatar.client {
  background: linear-gradient(135deg, #C69C63 0%, #8D6238 100%);
  color: #FFFFFF;
  font-size: 28rpx;
}

.avatar-img.small {
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
}

.auth-info {
  flex: 1;
}

.auth-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.auth-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
}

.role-pill {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.role-pill.client {
  background: #F7EFE5;
  color: #8D6238;
  border: 1rpx solid rgba(141, 98, 56, 0.25);
}

.role-pill.admin {
  background: #241E1A;
  color: #E2B678;
}

.auth-desc {
  display: block;
  font-size: 22rpx;
  color: #7D736A;
  line-height: 1.4;
}

.logout-link {
  font-size: 24rpx;
  color: #8D6238;
  border: 1rpx solid #D5C3AE;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
}

.auth-btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #F2ECE3;
}

.auth-action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 36rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.auth-action-btn.primary {
  background: linear-gradient(135deg, #A88152 0%, #8D6238 100%);
  color: #FFFFFF;
}

.auth-action-btn.admin-outline {
  background: #FAF7F2;
  color: #3A3028;
  border: 1rpx solid #D6C7B5;
}

.top-order-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: #8D6238;
  font-weight: 500;
}

/* 登录弹窗 */
.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.login-box {
  background: #FFFFFF;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.login-tabs {
  display: flex;
  background: #F4EFE8;
}

.l-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #7D736A;
  font-weight: 500;
}

.l-tab.active {
  background: #FFFFFF;
  color: #8D6238;
  font-weight: 600;
}

.login-body {
  padding: 32rpx;
}

.login-tip {
  display: block;
  font-size: 23rpx;
  color: #6E6257;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.login-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #241E1A;
  margin-bottom: 18rpx;
}

.demo-accounts-box {
  background: #FDF9F2;
  border: 1rpx solid #EADBC8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 26rpx;
}

.da-label {
  display: block;
  font-size: 22rpx;
  color: #8D6238;
  margin-bottom: 12rpx;
}

.da-pills {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.da-pill {
  background: #FFFFFF;
  border: 1rpx solid #D8C3A8;
  color: #3A3028;
  font-size: 23rpx;
  padding: 12rpx 18rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.login-submit-btn {
  width: 100%;
}

/* 顶部名片 */
.profile-card {
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid #E8DFD3;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #241E1A;
}

.identity-tag {
  font-size: 20rpx;
  color: #8D6238;
  background: #F8EFE5;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(141, 98, 56, 0.2);
}

.user-title {
  display: block;
  font-size: 24rpx;
  color: #7D736A;
  line-height: 1.4;
}

.slogan-line {
  display: block;
  font-size: 24rpx;
  color: #9D754C;
  font-style: italic;
  margin-bottom: 28rpx;
  padding: 12rpx 20rpx;
  background: #FDFBF8;
  border-left: 4rpx solid #8D6238;
  border-radius: 4rpx;
}

.kpi-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid #F0ECE4;
  padding-top: 24rpx;
}

.kpi-cell {
  text-align: center;
}

.kpi-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #8D6238;
  display: block;
}

.kpi-txt {
  font-size: 22rpx;
  color: #8C8074;
  margin-top: 4rpx;
  display: block;
}

.kpi-split {
  width: 1rpx;
  height: 48rpx;
  background: #EFE8DE;
}

/* 预约记录卡片 */
.workspace-banner {
  background: linear-gradient(135deg, #241E1A 0%, #3B2E24 100%);
  border-radius: 22rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(36, 30, 26, 0.22);
  border: 1rpx solid rgba(226, 182, 120, 0.35);
}

.wb-left {
  flex: 1;
  margin-right: 20rpx;
}

.wb-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.wb-badge {
  font-size: 20rpx;
  background: #E2B678;
  color: #241E1A;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.wb-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFF7EB;
}

.wb-desc {
  display: block;
  font-size: 22rpx;
  color: #C7B9A8;
  line-height: 1.4;
}

.wb-btn {
  background: rgba(226, 182, 120, 0.2);
  border: 1rpx solid #E2B678;
  color: #F3DEC0;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.section-block {
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.block-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
}

.record-count {
  font-size: 22rpx;
  color: #9C9186;
}

.appointment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.appointment-item {
  background: #F9F7F3;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #8D6238;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2520;
}

.item-status {
  font-size: 22rpx;
  color: #8D6238;
  background: #F4EBE0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.item-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-line {
  font-size: 24rpx;
  color: #635A52;
}

.detail-line.time {
  font-size: 22rpx;
  color: #9C9287;
}

.detail-line.milestone {
  color: #8D6238;
  font-weight: 600;
}

.item-status.done {
  background: #E7F3E8;
  color: #2E6F3A;
}

.item-stats-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  margin-bottom: 20rpx;
}

.stat-pill {
  font-size: 20rpx;
  color: #6B5F54;
  background: #EFE9E0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #EBE4DA;
  padding-top: 18rpx;
}

.act-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.act-btn.outline {
  border: 1rpx solid #8D6238;
  color: #8D6238;
  background: #FFFFFF;
}

.act-btn.primary {
  background: #8D6238;
  color: #FFFFFF;
}

.empty-tip {
  text-align: center;
  color: #A3978B;
  font-size: 24rpx;
  padding: 20rpx 0;
}

/* 菜单项 */
.menu-group {
  padding: 10rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 34rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #2E2722;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-val {
  font-size: 24rpx;
  color: #8D6238;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C0B7AC;
}

.menu-divider {
  height: 1rpx;
  background: #F2EDE5;
}

/* FAQ 常见问题 */
.faq-block {
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 40rpx;
}

.faq-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1rpx solid #F0ECE4;
  padding: 24rpx 0;
}

.faq-q-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.faq-q {
  font-size: 26rpx;
  font-weight: 500;
  color: #38302A;
  flex: 1;
  padding-right: 20rpx;
}

.faq-arrow {
  font-size: 36rpx;
  color: #8D6238;
  font-weight: bold;
}

.faq-a {
  display: block;
  font-size: 24rpx;
  color: #6C6258;
  line-height: 1.6;
  margin-top: 14rpx;
  padding: 16rpx;
  background: #F9F7F3;
  border-radius: 8rpx;
}

/* 底部版权 */
.copyright-bar {
  text-align: center;
  padding: 20rpx 0;
}

.copyright-bar text {
  display: block;
  font-size: 20rpx;
  color: #A39688;
  line-height: 1.5;
}

.copyright-en {
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

/* 修改密码弹窗补充样式 */
.cp-box {
  padding: 36rpx 32rpx;
}

.cp-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 10rpx;
}

.cp-sub {
  display: block;
  font-size: 23rpx;
  color: #7D736A;
  margin-bottom: 24rpx;
}

.cp-btns {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
}

.cp-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.cp-btn.cancel {
  background: #F2EDE6;
  color: #6B6158;
}

.cp-btn.confirm {
  background: #8D6238;
  color: #FFFFFF;
}
