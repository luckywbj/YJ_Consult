/* pages/mine/mine.wxss */
.mine-container {
  padding: 30rpx 32rpx 80rpx 32rpx;
  background-color: #F8F6F2;
}

/* 顶部名片 */
.profile-card {
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid #E8DFD3;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #241E1A;
}

.identity-tag {
  font-size: 20rpx;
  color: #8D6238;
  background: #F8EFE5;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(141, 98, 56, 0.2);
}

.user-title {
  display: block;
  font-size: 24rpx;
  color: #7D736A;
  line-height: 1.4;
}

.slogan-line {
  display: block;
  font-size: 24rpx;
  color: #9D754C;
  font-style: italic;
  margin-bottom: 28rpx;
  padding: 12rpx 20rpx;
  background: #FDFBF8;
  border-left: 4rpx solid #8D6238;
  border-radius: 4rpx;
}

.kpi-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid #F0ECE4;
  padding-top: 24rpx;
}

.kpi-cell {
  text-align: center;
}

.kpi-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #8D6238;
  display: block;
}

.kpi-txt {
  font-size: 22rpx;
  color: #8C8074;
  margin-top: 4rpx;
  display: block;
}

.kpi-split {
  width: 1rpx;
  height: 48rpx;
  background: #EFE8DE;
}

/* 预约记录卡片 */
.section-block {
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.block-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
}

.record-count {
  font-size: 22rpx;
  color: #9C9186;
}

.appointment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.appointment-item {
  background: #F9F7F3;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #8D6238;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2520;
}

.item-status {
  font-size: 22rpx;
  color: #8D6238;
  background: #F4EBE0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.item-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-line {
  font-size: 24rpx;
  color: #635A52;
}

.detail-line.time {
  font-size: 22rpx;
  color: #9C9287;
}

.empty-tip {
  text-align: center;
  color: #A3978B;
  font-size: 24rpx;
  padding: 20rpx 0;
}

/* 菜单项 */
.menu-group {
  padding: 10rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 36rpx;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 34rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #2E2722;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-val {
  font-size: 24rpx;
  color: #8D6238;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C0B7AC;
}

.menu-divider {
  height: 1rpx;
  background: #F2EDE5;
}

/* FAQ 常见问题 */
.faq-block {
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 40rpx;
}

.faq-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  border-bottom: 1rpx solid #F0ECE4;
  padding: 24rpx 0;
}

.faq-q-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.faq-q {
  font-size: 26rpx;
  font-weight: 500;
  color: #38302A;
  flex: 1;
  padding-right: 20rpx;
}

.faq-arrow {
  font-size: 36rpx;
  color: #8D6238;
  font-weight: bold;
}

.faq-a {
  display: block;
  font-size: 24rpx;
  color: #6C6258;
  line-height: 1.6;
  margin-top: 14rpx;
  padding: 16rpx;
  background: #F9F7F3;
  border-radius: 8rpx;
}

/* 底部版权 */
.copyright-bar {
  text-align: center;
  padding: 20rpx 0;
}

.copyright-bar text {
  display: block;
  font-size: 20rpx;
  color: #A39688;
  line-height: 1.5;
}

.copyright-en {
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}
