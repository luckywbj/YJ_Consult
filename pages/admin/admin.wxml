<!-- pages/admin/admin.wxml -->
<!-- 未以导师身份登录当前工作室时，显示工作室登录锁屏，彻底阻断非授权访问 -->
<view class="admin-auth-guard" wx:if="{{auth.role !== 'admin'}}">
  <view class="guard-card luxury-card">
    <text class="guard-icon">🔐</text>
    <text class="guard-title">导师工作室登录</text>
    <text class="guard-sub">每位导师用自己的工作室账号登录，只能管理自己的门户与客户，互相不可见。</text>
    <input
      class="guard-input"
      type="number"
      maxlength="11"
      placeholder="工作室登录手机号（演示：13800000001）"
      value="{{guardPhone}}"
      bindinput="onGuardPhoneInput" />
    <input 
      class="guard-input" 
      password="true" 
      placeholder="登录密码（演示：8888）" 
      value="{{passInput}}" 
      bindinput="onGuardPassInput" />
    <button class="gold-btn full-btn" bindtap="unlockAdmin">登录我的工作室</button>
    <view class="guard-back" bindtap="goRegister">还没有工作室？立即开通（免费试用） ›</view>
    <view class="guard-back muted" bindtap="goBackClient">返回首页</view>
  </view>
</view>

<view class="admin-page" wx:else>
  <!-- 顶部工作台横幅与项目选择 -->
  <view class="admin-header">
    <view class="ah-top">
      <text class="ah-badge">{{auth.byPlatform ? '平台代管模式' : 'MY STUDIO · 我的工作室'}}</text>
      <view class="ah-top-btns">
        <view class="brand-cfg-quick-btn" bindtap="switchAdminTab" data-tab="4">⚙️ 标品装修</view>
        <view class="preview-client-btn" bindtap="goToPortalHome">预览门户 ›</view>
      </view>
    </view>
    <text class="ah-title">{{brandForm.navTitle}} · 工作室后台</text>

    <!-- 工作室账号与专属分享链接 -->
    <view class="studio-info-bar">
      <view class="sib-left">
        <text class="sib-plan {{tenantStatus.warning ? 'warn' : ''}}">{{tenantStatus.label}}</text>
        <text class="sib-id">工作室ID：{{tenant.tenantId}} · 到期 {{tenant.expireTime}}</text>
      </view>
      <button class="share-portal-btn" open-type="share">📤 分享我的门户</button>
    </view>
    <view class="portal-path-row" bindtap="copyPortalPath">
      <text class="pp-label">专属门户路径：</text>
      <text class="pp-val">{{portalPath}}</text>
      <text class="pp-copy">复制</text>
    </view>

    <!-- 选择当前操作的客户订单 -->
    <view class="client-selector-box">
      <text class="cs-label">我的客户项目（{{allProjects.length}} 个，点击切换）：</text>
      <scroll-view class="client-pills-scroll" scroll-x="true" enable-flex="true" wx:if="{{allProjects.length > 0}}">
        <view 
          class="client-pill {{item.id === project.id ? 'active' : ''}}" 
          wx:for="{{allProjects}}" 
          wx:key="id"
          bindtap="selectProject"
          data-id="{{item.id}}">
          <text class="cp-name">{{item.name}} · {{item.industry}}</text>
          <text class="cp-plan">{{item.type}} ({{item.stepName}})</text>
        </view>
      </scroll-view>
      <text class="cs-empty" wx:else>暂无客户。可在「4.新建档」为线下签约客户建档，或分享门户让客户在线下单。</text>
    </view>
  </view>

  <!-- 操作模块切换导航（5张无序号抽屉卡片，高亮卡片向下延伸与下方正文面板融为一体） -->
  <view class="module-nav-row">
    <view class="module-card {{adminTab === 0 ? 'active' : ''}}" bindtap="switchAdminTab" data-tab="0">
      <text class="mc-icon">📝</text>
      <text class="mc-name">咨询</text>
      <view class="mc-bridge" wx:if="{{adminTab === 0}}"></view>
    </view>
    <view class="module-card {{adminTab === 1 ? 'active' : ''}}" bindtap="switchAdminTab" data-tab="1">
      <text class="mc-icon">📄</text>
      <text class="mc-name">方案</text>
      <view class="mc-bridge" wx:if="{{adminTab === 1}}"></view>
    </view>
    <view class="module-card {{adminTab === 2 ? 'active' : ''}}" bindtap="switchAdminTab" data-tab="2">
      <text class="mc-icon">📈</text>
      <text class="mc-name">战果</text>
      <view class="mc-bridge" wx:if="{{adminTab === 2}}"></view>
    </view>
    <view class="module-card {{adminTab === 3 ? 'active' : ''}}" bindtap="switchAdminTab" data-tab="3">
      <text class="mc-icon">👤</text>
      <text class="mc-name">建档</text>
      <view class="mc-bridge" wx:if="{{adminTab === 3}}"></view>
    </view>
    <view class="module-card highlight-card {{adminTab === 4 ? 'active' : ''}}" bindtap="switchAdminTab" data-tab="4">
      <text class="mc-icon">⚙️</text>
      <text class="mc-name">装修</text>
      <view class="mc-bridge" wx:if="{{adminTab === 4}}"></view>
    </view>
  </view>

  <!-- 新工作室还没有客户时，前三个模块给出引导 -->
  <view class="admin-panel tab-{{adminTab}}" wx:if="{{!project && adminTab < 3}}">
    <view class="panel-card luxury-card empty-guide connected-panel">
      <text class="eg-icon">🗂️</text>
      <text class="panel-title">还没有客户项目</text>
      <text class="panel-sub">先为客户建档，或把你的门户分享给客户在线下单，之后就能在这里录入咨询过程与交付方案。</text>
      <button class="gold-btn full-btn" bindtap="switchAdminTab" data-tab="3">为第一位客户建档</button>
    </view>
  </view>

  <!-- ==================== 模块 0：录入每次咨询过程记录 ==================== -->
  <view class="admin-panel tab-0" wx:if="{{adminTab === 0 && project}}">
    <view class="panel-card luxury-card connected-panel">
      <view class="panel-title-row">
        <text class="panel-title">{{editingSessionId ? '编辑第 ' + editingSessionNo + ' 次咨询过程纪要' : '新增第 ' + (project.sessions.length + 1) + ' 次咨询过程纪要'}}</text>
        <view class="title-actions">
          <text class="cancel-edit-btn" wx:if="{{editingSessionId}}" bindtap="cancelEditSession">取消编辑</text>
          <text class="quick-fill-btn" wx:else bindtap="fillDemoSession">⚡ 一键填入示例数据</text>
        </view>
      </view>
      <text class="panel-sub">保存后将实时同步至【{{project.name}}】的咨询过程时间轴，并向客户派发课后落地行动项。</text>

      <view class="f-group">
        <text class="f-label">本次咨询主题 *</text>
        <input class="f-input" placeholder="如：高客单产品矩阵重构与首场私享会发售推演" value="{{sessionForm.title}}" bindinput="onSesTitle" />
      </view>

      <view class="f-group">
        <view class="label-with-action">
          <text class="f-label">咨询日期 / 时间 *</text>
          <picker mode="date" value="{{sessionForm.date}}" bindchange="onSesDatePick">
            <text class="date-pick-tag">📅 日历选期</text>
          </picker>
        </view>
        <input class="f-input" placeholder="如：2026-11-27 或 2026-11-27 14:30" value="{{sessionForm.date}}" bindinput="onSesDate" />
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">咨询形式 / 地点</text>
          <input class="f-input" placeholder="如：线下闭门 / 腾讯会议" value="{{sessionForm.mode}}" bindinput="onSesMode" />
        </view>
        <view class="f-group half">
          <text class="f-label">参会人员</text>
          <input class="f-input" placeholder="如：首席导师、创始人及高管" value="{{sessionForm.participants}}" bindinput="onSesParticipants" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">01 · 核心商业痛点诊断 *</text>
        <textarea class="f-textarea" placeholder="记录本次咨询剖析出的客户核心经营卡点与利润漏洞..." value="{{sessionForm.diagnosis}}" bindinput="onSesDiagnosis"></textarea>
      </view>

      <view class="f-group">
        <text class="f-label">02 · 破局重构解法 *</text>
        <textarea class="f-textarea" placeholder="记录本次给出的高客单定价策略、成交漏斗设计或组织操盘解法..." value="{{sessionForm.solution}}" bindinput="onSesSolution"></textarea>
      </view>

      <view class="f-group">
        <text class="f-label">03 · 课后落地行动清单（每行一条，客户可打钩打卡）</text>
        <textarea class="f-textarea" placeholder="每行输入一条要求客户团队完成的落地动作，例如：\n1. 筛选近半年TOP 30高净值老客名单\n2. 完成销售团队高客单话术通关考核" value="{{sessionForm.actionsText}}" bindinput="onSesActions"></textarea>
      </view>

      <view class="f-group">
        <text class="f-label">04 · 顾问复盘批注（选填）</text>
        <input class="f-input" placeholder="对客户团队执行力的点评或下一阶段重点叮嘱" value="{{sessionForm.consultantNote}}" bindinput="onSesNote" />
      </view>

      <button class="gold-btn full-btn" bindtap="submitNewSession">{{editingSessionId ? '保存修改并同步至客户空间' : '保存并同步至客户交付空间'}}</button>
    </view>

    <!-- 已录入的咨询场次列表预览 -->
    <view class="history-card luxury-card">
      <view class="his-head-row">
        <text class="his-title">该项目已录入的咨询过程 ({{project.sessions.length}} 场)</text>
        <text class="his-feedback-stat" wx:if="{{feedbackCount > 0}}">{{feedbackCount}} 场有评价</text>
      </view>
      <view class="his-item" wx:for="{{project.sessions}}" wx:key="sessionId">
        <view class="his-top">
          <view class="his-top-left">
            <text class="his-badge">第 {{item.sessionNo}} 次</text>
            <text class="his-date">{{item.date}}</text>
          </view>
          <text class="his-edit-btn" bindtap="editSessionItem" data-sesid="{{item.sessionId}}">✏️ 编辑</text>
        </view>
        <text class="his-name">{{item.title}}</text>
        <text class="his-sub">含 {{item.actionItems.length}} 项课后落地任务</text>

        <!-- 客户单场反馈及导师回复 -->
        <view class="his-client-fb" wx:if="{{item.clientFeedback || item.clientRating > 0}}">
          <view class="hcf-top">
            <text class="hcf-tag">客户评价 · {{item.clientRating || 5}}.0 ★</text>
            <text class="hcf-time" wx:if="{{item.clientFeedbackTime}}">{{item.clientFeedbackTime}}</text>
          </view>
          <text class="hcf-txt" wx:if="{{item.clientFeedback}}">“{{item.clientFeedback}}”</text>

          <view class="hcf-reply" wx:if="{{item.consultantReply}}">
            <text class="hcf-reply-label">我的回复：</text>
            <text class="hcf-reply-txt">{{item.consultantReply}}</text>
          </view>
          <view class="hcf-actions">
            <text
              class="reply-trigger-btn"
              bindtap="openReplyModal"
              data-sesid="{{item.sessionId}}"
              data-sesno="{{item.sessionNo}}"
              data-sestitle="{{item.title}}"
              data-feedback="{{item.clientFeedback || ''}}"
              data-reply="{{item.consultantReply || ''}}"
            >{{item.consultantReply ? '修改回复' : '💬 回复客户评价'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 模块 1：上传/发布阶段交付成果方案 ==================== -->
  <view class="admin-panel tab-1" wx:if="{{adminTab === 1 && project}}">
    <view class="panel-card luxury-card connected-panel">
      <view class="panel-title-row">
        <text class="panel-title">发布阶段交付方案 / SOP 文档</text>
        <text class="quick-fill-btn" bindtap="fillDemoDeliverable">⚡ 一键填入示例方案</text>
      </view>
      <text class="panel-sub">发布后客户可在「交付结果看板」查阅方案详情并进行在线确认验收。</text>

      <view class="f-group">
        <text class="f-label">交付成果文档标题 *</text>
        <input class="f-input" placeholder="如：《企业10倍客单破局行动路线图与话术SOP》" value="{{delivForm.title}}" bindinput="onDelivTitle" />
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">所属交付阶段</text>
          <picker bindchange="onDelivStageChange" value="{{delivForm.stageIndex}}" range="{{stageOptions}}">
            <view class="f-picker">{{stageOptions[delivForm.stageIndex]}} ▼</view>
          </picker>
        </view>
        <view class="f-group half">
          <text class="f-label">文档类型标注</text>
          <input class="f-input" placeholder="如：PDF / 操盘全案" value="{{delivForm.fileType}}" bindinput="onDelivType" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">交付方案核心内容与执行要点摘要 *</text>
        <textarea class="f-textarea tall" placeholder="详细描述该份交付物包含的核心模块、定价表、发售剧本或SOP执行标准..." value="{{delivForm.summary}}" bindinput="onDelivSummary"></textarea>
      </view>

      <button class="gold-btn full-btn" bindtap="submitNewDeliverable">发布交付成果至客户空间</button>
    </view>

    <!-- 已发布交付物列表 -->
    <view class="history-card luxury-card">
      <text class="his-title">该项目已发布的交付成果 ({{project.deliverables.length}} 份)</text>
      <view class="his-item" wx:for="{{project.deliverables}}" wx:key="delivId">
        <view class="his-top">
          <text class="his-badge">{{item.stage}}</text>
          <text class="his-status">{{item.status}}</text>
        </view>
        <text class="his-name">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- ==================== 模块 2：推进五步阶段与更新商业战果看板 ==================== -->
  <view class="admin-panel tab-2" wx:if="{{adminTab === 2 && project}}">
    <!-- 推进 5 步里程碑 -->
    <view class="panel-card luxury-card connected-panel">
      <text class="panel-title">推进项目 5 步闭环交付阶段</text>
      <text class="panel-sub">点击下方阶段节点，立即切换【{{project.name}}】当前所处的交付里程碑：</text>

      <view class="step-selector-grid">
        <view 
          class="step-select-btn {{project.currentStep === item.step ? 'current' : (project.currentStep > item.step ? 'passed' : '')}}" 
          wx:for="{{steps}}" 
          wx:key="step"
          bindtap="onChangeStep"
          data-step="{{item.step}}">
          <text class="ss-code">{{item.code}}</text>
          <text class="ss-name">{{item.title}}</text>
        </view>
      </view>
    </view>

    <!-- 更新客户服务前后业绩增长看板 -->
    <view class="panel-card luxury-card">
      <text class="panel-title">更新商业增长战果对比看板</text>
      <text class="panel-sub">实时维护客户服务前后的客单价、毛利率、营收规模与阶段战果复盘：</text>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">服务前客单价</text>
          <input class="f-input" value="{{metricsForm.ticketBefore}}" bindinput="onMetTicketBefore" />
        </view>
        <view class="f-group half">
          <text class="f-label">服务后达成客单价 *</text>
          <input class="f-input highlight" value="{{metricsForm.ticketAfter}}" bindinput="onMetTicketAfter" />
        </view>
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">服务前综合毛利率</text>
          <input class="f-input" value="{{metricsForm.marginBefore}}" bindinput="onMetMarginBefore" />
        </view>
        <view class="f-group half">
          <text class="f-label">服务后达成毛利率 *</text>
          <input class="f-input highlight" value="{{metricsForm.marginAfter}}" bindinput="onMetMarginAfter" />
        </view>
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">服务前月均营收</text>
          <input class="f-input" value="{{metricsForm.revenueBefore}}" bindinput="onMetRevBefore" />
        </view>
        <view class="f-group half">
          <text class="f-label">服务后达成营收 *</text>
          <input class="f-input highlight" value="{{metricsForm.revenueAfter}}" bindinput="onMetRevAfter" />
        </view>
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">服务前转化率</text>
          <input class="f-input" value="{{metricsForm.conversionBefore}}" bindinput="onMetConvBefore" />
        </view>
        <view class="f-group half">
          <text class="f-label">服务后高客单转化率 *</text>
          <input class="f-input highlight" value="{{metricsForm.conversionAfter}}" bindinput="onMetConvAfter" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">阶段实战战果复盘总结</text>
        <textarea class="f-textarea" value="{{metricsForm.highlightSummary}}" bindinput="onMetSummary"></textarea>
      </view>

      <button class="gold-btn full-btn" bindtap="saveMetricsUpdate">保存并更新客户战果看板</button>
    </view>
  </view>

  <!-- ==================== 模块 3：为线下签约客户建档立项 ==================== -->
  <view class="admin-panel tab-3" wx:if="{{adminTab === 3}}">
    <view class="panel-card luxury-card connected-panel">
      <text class="panel-title">为线下签约客户新建咨询档案</text>
      <text class="panel-sub">建档后，客户在小程序「我的」页面输入下方绑定的手机号及专属密码登录，即可查看自己的专属咨询交付空间（与其他客户严格隔离）。</text>

      <view class="f-group">
        <text class="f-label">客户称呼 / 创始人姓名 *</text>
        <input class="f-input" placeholder="如：王总 / 林女士" value="{{newClientForm.name}}" bindinput="onNewClientName" />
      </view>

      <view class="f-group">
        <text class="f-label">客户登录绑定手机号 *（客户凭此号码登录）</text>
        <input class="f-input highlight" type="number" placeholder="如：13688889999" value="{{newClientForm.phone}}" bindinput="onNewClientPhone" />
      </view>

      <view class="f-group">
        <view class="label-with-action">
          <text class="f-label">客户专属登录密码（4位以上，留空默认手机号后6位）</text>
          <text class="quick-fill-btn" bindtap="genRandomClientPass">🎲 随机生成</text>
        </view>
        <input class="f-input highlight" placeholder="可直接输入或点击右侧随机生成 6 位数字密码" value="{{newClientForm.password}}" bindinput="onNewClientPassword" />
      </view>

      <view class="f-group">
        <text class="f-label">客户所在行业 *</text>
        <input class="f-input" placeholder="如：高定珠宝 / 知识付费 / 医疗美容" value="{{newClientForm.industry}}" bindinput="onNewClientIndustry" />
      </view>

      <view class="f-group">
        <text class="f-label">签约咨询方案</text>
        <picker bindchange="onNewClientPlanChange" value="{{newClientForm.planIndex}}" range="{{planOptions}}">
          <view class="f-picker">{{planOptions[newClientForm.planIndex]}} ▼</view>
        </picker>
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">服务前客单价基准</text>
          <input class="f-input" placeholder="如：¥1,800" value="{{newClientForm.ticketBefore}}" bindinput="onNewClientTicket" />
        </view>
        <view class="f-group half">
          <text class="f-label">服务前月营收基准</text>
          <input class="f-input" placeholder="如：50万/月" value="{{newClientForm.revenueBefore}}" bindinput="onNewClientRev" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">诊前核心痛点备注</text>
        <textarea class="f-textarea" placeholder="录入该客户签约时的核心痛点与破局目标..." value="{{newClientForm.problem}}" bindinput="onNewClientProblem"></textarea>
      </view>

      <button class="gold-btn full-btn" bindtap="createOfflineClientOrder">确认建档并开通该客户专属交付空间</button>
    </view>
  </view>

  <!-- ==================== 模块 4：⚙️ 标品白牌化装修中心（White-Label SaaS 配置） ==================== -->
  <view class="admin-panel tab-4" wx:if="{{adminTab === 4}}">
    <!-- 卡片1：销售谈单神器——一键切换三大行业标品母版 -->
    <view class="panel-card luxury-card connected-panel">
      <text class="panel-title">⚡ 一键切换行业标品演示母版</text>
      <text class="panel-sub">向不同行业的咨询导师/机构主理人销售演示时，点击下方行业模板即可在 1 秒内完成全站品牌、套餐与案例库切换：</text>

      <view class="preset-list">
        <view 
          class="preset-item {{brandForm.presetKey === 'yanjie' ? 'active' : ''}}" 
          bindtap="onApplyPreset" 
          data-preset="yanjie">
          <view class="pi-top">
            <text class="pi-name">母版 A：岩姐商业咨询（商业操盘 / 知识 IP）</text>
            <text class="pi-tag" wx:if="{{brandForm.presetKey === 'yanjie'}}">当前使用中</text>
          </view>
          <text class="pi-desc">适合：商业咨询师、私董会主理人、个人品牌IP、营销操盘手</text>
        </view>

        <view 
          class="preset-item {{brandForm.presetKey === 'finance' ? 'active' : ''}}" 
          bindtap="onApplyPreset" 
          data-preset="finance">
          <view class="pi-top">
            <text class="pi-name">母版 B：卓远财税私董会（财税 / 股权 / 律所）</text>
            <text class="pi-tag" wx:if="{{brandForm.presetKey === 'finance'}}">当前使用中</text>
          </view>
          <text class="pi-desc">适合：财税咨询机构、股权架构师、律师事务所、战略管理咨询公司</text>
        </view>

        <view 
          class="preset-item {{brandForm.presetKey === 'aesthetics' ? 'active' : ''}}" 
          bindtap="onApplyPreset" 
          data-preset="aesthetics">
          <view class="pi-top">
            <text class="pi-name">母版 C：东方奢美增长院（美业 / 大健康 / 连锁）</text>
            <text class="pi-tag" wx:if="{{brandForm.presetKey === 'aesthetics'}}">当前使用中</text>
          </view>
          <text class="pi-desc">适合：医美双美操盘机构、大健康抗衰会所、高端连锁陪跑团队</text>
        </view>
      </view>
    </view>

    <!-- 卡片2：自定义品牌门户与导师 IP 名片 -->
    <view class="panel-card luxury-card">
      <text class="panel-title">1 · 品牌门户与首席导师 IP 自定义</text>
      <text class="panel-sub">购买标品的客户无需懂代码，在此修改后首页、「我的」页面与导航栏立即生效：</text>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">首页品牌大标题 *</text>
          <input class="f-input highlight" value="{{brandForm.brandName}}" bindinput="onBrandField" data-field="brandName" />
        </view>
        <view class="f-group half">
          <text class="f-label">顶部导航栏简称 *</text>
          <input class="f-input" value="{{brandForm.navTitle}}" bindinput="onBrandField" data-field="navTitle" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">英文品牌副标题</text>
        <input class="f-input" value="{{brandForm.brandSubtitle}}" bindinput="onBrandField" data-field="brandSubtitle" />
      </view>

      <view class="f-group">
        <text class="f-label">品牌使命 (Mission)</text>
        <input class="f-input" value="{{brandForm.mission}}" bindinput="onBrandField" data-field="mission" />
      </view>

      <view class="f-group">
        <text class="f-label">品牌愿景 (Vision)</text>
        <input class="f-input" value="{{brandForm.vision}}" bindinput="onBrandField" data-field="vision" />
      </view>

      <view class="f-group">
        <text class="f-label">核心商业理念 (Philosophy)</text>
        <input class="f-input" value="{{brandForm.philosophy}}" bindinput="onBrandField" data-field="philosophy" />
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">首席导师姓名 *</text>
          <input class="f-input highlight" value="{{brandForm.mentorName}}" bindinput="onBrandField" data-field="mentorName" />
        </view>
        <view class="f-group half">
          <text class="f-label">导师身份徽章</text>
          <input class="f-input" value="{{brandForm.mentorBadge}}" bindinput="onBrandField" data-field="mentorBadge" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">导师个人页专业头衔</text>
        <input class="f-input" value="{{brandForm.mentorTitle}}" bindinput="onBrandField" data-field="mentorTitle" />
      </view>

      <view class="f-group">
        <text class="f-label">导师商业金句</text>
        <input class="f-input" value="{{brandForm.mentorMotto}}" bindinput="onBrandField" data-field="mentorMotto" />
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">战绩1数值（如300+）</text>
          <input class="f-input" value="{{brandForm.stat1Num}}" bindinput="onBrandField" data-field="stat1Num" />
        </view>
        <view class="f-group half">
          <text class="f-label">战绩1标签</text>
          <input class="f-input" value="{{brandForm.stat1Tag}}" bindinput="onBrandField" data-field="stat1Tag" />
        </view>
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">战绩2数值（如10倍+）</text>
          <input class="f-input" value="{{brandForm.stat2Num}}" bindinput="onBrandField" data-field="stat2Num" />
        </view>
        <view class="f-group half">
          <text class="f-label">战绩2标签</text>
          <input class="f-input" value="{{brandForm.stat2Tag}}" bindinput="onBrandField" data-field="stat2Tag" />
        </view>
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">官方咨询微信号</text>
          <input class="f-input" value="{{brandForm.wechat}}" bindinput="onBrandField" data-field="wechat" />
        </view>
        <view class="f-group half">
          <text class="f-label">VIP 咨询热线</text>
          <input class="f-input" value="{{brandForm.phone}}" bindinput="onBrandField" data-field="phone" />
        </view>
      </view>

      <button class="gold-btn full-btn" bindtap="saveBrandInfo">保存品牌门户与导师配置</button>
    </view>

    <!-- 卡片3：三大核心服务套餐与价格配置 -->
    <view class="panel-card luxury-card">
      <text class="panel-title">2 · 核心服务套餐与立项定价配置</text>
      <text class="panel-sub">自定义「服务」页展示的三大咨询套餐名称、全案价格与立项定金：</text>

      <view class="pkg-edit-box" wx:for="{{brandForm.services}}" wx:key="id">
        <text class="pkg-index-title">套餐 {{index + 1}}（{{item.tier}}）</text>
        <view class="f-group">
          <text class="f-label">套餐名称</text>
          <input class="f-input" value="{{item.name}}" bindinput="onPkgField" data-idx="{{index}}" data-field="name" />
        </view>
        <view class="f-row">
          <view class="f-group half">
            <text class="f-label">全案价格 (元)</text>
            <input class="f-input highlight" type="number" value="{{item.price}}" bindinput="onPkgField" data-idx="{{index}}" data-field="price" />
          </view>
          <view class="f-group half">
            <text class="f-label">立项定金 (元)</text>
            <input class="f-input" type="number" value="{{item.deposit}}" bindinput="onPkgField" data-idx="{{index}}" data-field="deposit" />
          </view>
        </view>
        <view class="f-group">
          <text class="f-label">稀缺席位说明</text>
          <input class="f-input" value="{{item.quota}}" bindinput="onPkgField" data-idx="{{index}}" data-field="quota" />
        </view>
      </view>

      <button class="gold-btn full-btn" bindtap="savePackagesConfig">保存三大服务套餐定价</button>
    </view>

    <!-- 卡片4：后台新增实战操盘案例到「案例」页 -->
    <view class="panel-card luxury-card">
      <view class="panel-title-row">
        <text class="panel-title">3 · 新增实战成功案例</text>
        <text class="quick-fill-btn" bindtap="fillDemoCase">⚡ 一键填入示例案例</text>
      </view>
      <text class="panel-sub">发布后立即展示在小程序「案例」页，并自动生成分类筛选标签：</text>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">案例分类标签 *</text>
          <input class="f-input" placeholder="如：高客单操盘" value="{{newCaseForm.category}}" bindinput="onCaseField" data-field="category" />
        </view>
        <view class="f-group half">
          <text class="f-label">业绩亮点角标 *</text>
          <input class="f-input highlight" placeholder="如：单月业绩破500W" value="{{newCaseForm.badge}}" bindinput="onCaseField" data-field="badge" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">案例主标题 *</text>
        <input class="f-input" placeholder="如：某高端品牌从价格战跃迁至高客单闭环" value="{{newCaseForm.title}}" bindinput="onCaseField" data-field="title" />
      </view>

      <view class="f-row">
        <view class="f-group half">
          <text class="f-label">服务前数据 *</text>
          <input class="f-input" placeholder="如：客单600元·微利" value="{{newCaseForm.beforeVal}}" bindinput="onCaseField" data-field="beforeVal" />
        </view>
        <view class="f-group half">
          <text class="f-label">服务后数据 *</text>
          <input class="f-input highlight" placeholder="如：客单3.8万·毛利70%" value="{{newCaseForm.afterVal}}" bindinput="onCaseField" data-field="afterVal" />
        </view>
      </view>

      <view class="f-group">
        <text class="f-label">核心操盘抓手 *</text>
        <textarea class="f-textarea" placeholder="简述该案例的核心破局策略与落地抓手..." value="{{newCaseForm.coreStrategy}}" bindinput="onCaseField" data-field="coreStrategy"></textarea>
      </view>

      <view class="f-group">
        <text class="f-label">客户称呼与背书身份 *</text>
        <input class="f-input" placeholder="如：周总（某连锁品牌创始人）" value="{{newCaseForm.clientName}}" bindinput="onCaseField" data-field="clientName" />
      </view>

      <button class="gold-btn full-btn" bindtap="publishNewCase">发布新案例至前端案例库</button>
    </view>
  </view>

  <!-- 弹窗：导师回复客户单场反馈 -->
  <view class="modal-mask" wx:if="{{replyModal.visible}}" bindtap="closeReplyModal">
    <view class="modal-box" catchtap="preventBubble">
      <text class="modal-title">回复第 {{replyModal.sessionNo}} 次咨询客户评价</text>
      <text class="modal-sub">{{replyModal.sessionTitle}}</text>
      <view class="modal-quote" wx:if="{{replyModal.clientFeedback}}">
        <text class="mq-txt">客户原话：“{{replyModal.clientFeedback}}”</text>
      </view>
      <textarea
        class="modal-textarea"
        placeholder="输入导师针对本场反馈的回应或下阶段重点安排..."
        value="{{replyModal.replyText}}"
        bindinput="onReplyInput"
      ></textarea>
      <view class="modal-btns">
        <view class="m-btn cancel" bindtap="closeReplyModal">取消</view>
        <view class="m-btn confirm" bindtap="submitReplyFeedback">发送回复</view>
      </view>
    </view>
  </view>
</view>
