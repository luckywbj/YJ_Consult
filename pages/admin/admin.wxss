/* pages/admin/admin.wxss */
.admin-auth-guard {
  min-height: 100vh;
  background-color: #F8F6F2;
  padding: 80rpx 36rpx;
  box-sizing: border-box;
}

.guard-card {
  background: #FFFFFF;
  padding: 50rpx 36rpx;
  text-align: center;
}

.guard-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.guard-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 12rpx;
}

.guard-sub {
  display: block;
  font-size: 24rpx;
  color: #7D736A;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.guard-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.guard-back {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #8D6238;
}

.guard-back.muted {
  margin-top: 18rpx;
  color: #A39688;
}

/* 工作室账号信息与分享 */
.studio-info-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.sib-left {
  flex: 1;
  margin-right: 16rpx;
}

.sib-plan {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #E2B678;
}

.sib-plan.warn {
  color: #FFB36B;
}

.sib-id {
  display: block;
  font-size: 20rpx;
  color: #B6A797;
  margin-top: 4rpx;
}

.share-portal-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #241E1A;
  background: #E2B678;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.share-portal-btn::after {
  border: none;
}

.portal-path-row {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  margin-bottom: 22rpx;
}

.pp-label {
  color: #B6A797;
}

.pp-val {
  flex: 1;
  color: #EBDCCB;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-copy {
  color: #E2B678;
  margin-left: 12rpx;
}

.cs-empty {
  display: block;
  font-size: 22rpx;
  color: #C7B9A8;
  line-height: 1.5;
}

.empty-guide {
  text-align: center;
}

.eg-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.admin-page {
  min-height: 100vh;
  background-color: #F8F6F2;
  padding-bottom: 100rpx;
}

.admin-header {
  background: linear-gradient(155deg, #1E1915 0%, #352920 100%);
  padding: 28rpx 32rpx 36rpx 32rpx;
  color: #FFFFFF;
}

.ah-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.ah-badge {
  font-size: 20rpx;
  color: #E2B678;
  letter-spacing: 1rpx;
}

.ah-top-btns {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.brand-cfg-quick-btn {
  font-size: 22rpx;
  color: #FFF7EB;
  background: #8D6238;
  border: 1rpx solid #E2B678;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.preview-client-btn {
  font-size: 22rpx;
  color: #241E1A;
  background: #E2B678;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.ah-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF7EB;
  margin-bottom: 24rpx;
}

.cs-label {
  display: block;
  font-size: 22rpx;
  color: #C7B9A8;
  margin-bottom: 12rpx;
}

.client-pills-scroll {
  display: flex;
  white-space: nowrap;
  gap: 16rpx;
}

.client-pill {
  display: inline-flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
}

.client-pill.active {
  background: rgba(226, 182, 120, 0.22);
  border-color: #E2B678;
}

.cp-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.cp-plan {
  font-size: 20rpx;
  color: #D8C7B4;
}

/* 工作台模块导航（一屏5列完整显示） */
.admin-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EAE1D5;
  width: 100%;
}

.a-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 4rpx;
  font-size: 23rpx;
  color: #7D736A;
  font-weight: 500;
  border-bottom: 6rpx solid transparent;
  white-space: nowrap;
}

.a-tab.highlight-tab {
  color: #8D6238;
  font-weight: 600;
  background: #FDF9F2;
}

.a-tab.active {
  color: #8D6238;
  font-weight: 700;
  border-bottom-color: #8D6238;
}

.admin-panel {
  padding: 28rpx 32rpx;
}

.panel-card {
  background: #FFFFFF;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
}

.panel-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
}

.quick-fill-btn {
  font-size: 22rpx;
  color: #8D6238;
  background: #F6EFE6;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.panel-sub {
  display: block;
  font-size: 22rpx;
  color: #8C8074;
  margin-bottom: 28rpx;
  line-height: 1.45;
}

.f-group {
  margin-bottom: 22rpx;
}

.f-row {
  display: flex;
  gap: 20rpx;
}

.f-group.half {
  flex: 1;
}

.f-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #3A312A;
  margin-bottom: 10rpx;
}

.f-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
}

.f-input.highlight {
  border-color: #C29B6B;
  background: #FDF9F2;
  font-weight: 600;
  color: #8D6238;
}

.f-picker {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
}

.f-textarea {
  width: 100%;
  height: 160rpx;
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
  box-sizing: border-box;
}

.f-textarea.tall {
  height: 220rpx;
}

.full-btn {
  width: 100%;
  margin-top: 12rpx;
}

/* 历史列表 */
.history-card {
  background: #FFFFFF;
  padding: 32rpx;
}

.his-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 20rpx;
}

.his-item {
  background: #F9F7F3;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.his-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.his-badge {
  font-size: 20rpx;
  color: #8D6238;
  background: #EFE5D8;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.his-date,
.his-status {
  font-size: 22rpx;
  color: #8C8074;
}

.his-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2E2722;
}

.his-sub {
  display: block;
  font-size: 22rpx;
  color: #7D736A;
  margin-top: 4rpx;
}

/* 5步阶段选择网格 */
.step-selector-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.step-select-btn {
  flex: 1;
  background: #F7F4EE;
  border: 2rpx solid #E5DDD0;
  border-radius: 14rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-select-btn.passed {
  background: #F3ECE2;
  border-color: #C7AD8E;
}

.step-select-btn.current {
  background: #241E1A;
  border-color: #241E1A;
}

.ss-code {
  font-size: 24rpx;
  font-weight: 700;
  color: #8D6238;
  margin-bottom: 6rpx;
}

.step-select-btn.current .ss-code {
  color: #E2B678;
}

.ss-name {
  font-size: 22rpx;
  color: #3A312A;
}

.step-select-btn.current .ss-name {
  color: #FFFFFF;
  font-weight: 600;
}

/* 标品装修中心：行业预设母版选择器 */
.preset-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.preset-item {
  background: #FAF8F4;
  border: 2rpx solid #E5DDD0;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
}

.preset-item.active {
  background: #FDF9F2;
  border-color: #8D6238;
  box-shadow: 0 6rpx 18rpx rgba(141, 98, 56, 0.12);
}

.pi-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.pi-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #241E1A;
}

.pi-tag {
  font-size: 20rpx;
  background: #8D6238;
  color: #FFFFFF;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.pi-desc {
  display: block;
  font-size: 22rpx;
  color: #7D736A;
}

/* 套餐配置卡片 */
.pkg-edit-box {
  background: #FAF8F4;
  border: 1rpx solid #E8DFD2;
  border-radius: 14rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
}

.pkg-index-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8D6238;
  margin-bottom: 16rpx;
}
