/* pages/admin/admin.wxss */
.admin-auth-guard {
  min-height: 100vh;
  background-color: #F8F6F2;
  padding: 80rpx 36rpx;
  box-sizing: border-box;
}

.guard-card {
  background: #FFFFFF;
  padding: 50rpx 36rpx;
  text-align: center;
}

.guard-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.guard-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 12rpx;
}

.guard-sub {
  display: block;
  font-size: 24rpx;
  color: #7D736A;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.guard-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.guard-back {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #8D6238;
}

.admin-page {
  min-height: 100vh;
  background-color: #F8F6F2;
  padding-bottom: 100rpx;
}

.admin-header {
  background: linear-gradient(155deg, #1E1915 0%, #352920 100%);
  padding: 28rpx 32rpx 36rpx 32rpx;
  color: #FFFFFF;
}

.ah-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.ah-badge {
  font-size: 20rpx;
  color: #E2B678;
  letter-spacing: 2rpx;
}

.ah-top-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.top-accounts-btn {
  font-size: 22rpx;
  color: #F4EAE0;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  font-weight: 500;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.preview-client-btn {
  font-size: 22rpx;
  color: #241E1A;
  background: #E2B678;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
}

.ah-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF7EB;
  margin-bottom: 24rpx;
}

.cs-label {
  display: block;
  font-size: 22rpx;
  color: #C7B9A8;
  margin-bottom: 12rpx;
}

.client-pills-scroll {
  display: flex;
  white-space: nowrap;
  gap: 16rpx;
}

.client-pill {
  display: inline-flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
}

.client-pill.active {
  background: rgba(226, 182, 120, 0.22);
  border-color: #E2B678;
}

.cp-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.cp-plan {
  font-size: 20rpx;
  color: #D8C7B4;
}

/* 独立功能模块卡片（4x1 抽屉页签一体相连效果） */
.module-grid-wrap {
  padding: 22rpx 24rpx 0 24rpx;
  position: relative;
  z-index: 3;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  align-items: end;
}

.module-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #EFE8DE;
  border: 1rpx solid #E3D9CB;
  border-radius: 16rpx;
  padding: 16rpx 8rpx 14rpx 8rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
  transition: all 0.18s ease;
}

.module-card.active {
  background: #FFFFFF;
  border: 1rpx solid #E2D4C0;
  border-top: 6rpx solid #8D6238;
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
  padding: 16rpx 8rpx 26rpx 8rpx;
  margin-bottom: -2rpx;
  z-index: 4;
  box-shadow: 0 -4rpx 14rpx rgba(36, 30, 26, 0.04);
}

.mc-bridge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -4rpx;
  height: 8rpx;
  background: #FFFFFF;
  z-index: 5;
}

.mc-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  line-height: 1;
  padding: 4rpx 9rpx;
  border-radius: 16rpx;
  background: rgba(141, 98, 56, 0.12);
  color: #8D6238;
  font-weight: 600;
}

.module-card.active .mc-badge {
  background: #8D6238;
  color: #FFFFFF;
}

.mc-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  flex-shrink: 0;
}

.module-card.active .mc-icon {
  background: linear-gradient(135deg, #2A221C 0%, #1E1915 100%);
  box-shadow: 0 4rpx 10rpx rgba(36, 30, 26, 0.16);
}

.mc-title {
  font-size: 23rpx;
  font-weight: 500;
  color: #6B6158;
  line-height: 1.25;
  white-space: nowrap;
}

.module-card.active .mc-title {
  color: #8D6238;
  font-weight: 700;
}

.admin-panel {
  padding: 0 24rpx 28rpx 24rpx;
}

.panel-card {
  background: #FFFFFF;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
}

.panel-card.connected-panel {
  position: relative;
  z-index: 2;
  border: 1rpx solid #E2D4C0;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 26rpx rgba(36, 30, 26, 0.06);
}

.admin-panel.tab-0 .panel-card.connected-panel {
  border-top-left-radius: 0;
}

.admin-panel.tab-3 .panel-card.connected-panel {
  border-top-right-radius: 0;
}

.panel-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #241E1A;
}

.quick-fill-btn {
  font-size: 22rpx;
  color: #8D6238;
  background: #F6EFE6;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.panel-sub {
  display: block;
  font-size: 22rpx;
  color: #8C8074;
  margin-bottom: 28rpx;
  line-height: 1.45;
}

.f-group {
  margin-bottom: 22rpx;
}

.f-row {
  display: flex;
  gap: 20rpx;
}

.f-group.half {
  flex: 1;
}

.f-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #3A312A;
  margin-bottom: 10rpx;
}

.f-input {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
}

.f-input.highlight {
  border-color: #C29B6B;
  background: #FDF9F2;
  font-weight: 600;
  color: #8D6238;
}

.f-picker {
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
}

.f-textarea {
  width: 100%;
  height: 160rpx;
  background: #F9F7F3;
  border: 1rpx solid #E4DACD;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #241E1A;
  box-sizing: border-box;
}

.f-textarea.tall {
  height: 220rpx;
}

.full-btn {
  width: 100%;
  margin-top: 12rpx;
}

/* 历史列表 */
.history-card {
  background: #FFFFFF;
  padding: 32rpx;
}

.his-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 20rpx;
}

.his-item {
  background: #F9F7F3;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.his-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.his-badge {
  font-size: 20rpx;
  color: #8D6238;
  background: #EFE5D8;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.his-date,
.his-status {
  font-size: 22rpx;
  color: #8C8074;
}

.his-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2E2722;
}

.his-sub {
  display: block;
  font-size: 22rpx;
  color: #7D736A;
  margin-top: 4rpx;
}

/* 5步阶段选择网格 */
.step-selector-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.step-select-btn {
  flex: 1;
  background: #F7F4EE;
  border: 2rpx solid #E5DDD0;
  border-radius: 14rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-select-btn.passed {
  background: #F3ECE2;
  border-color: #C7AD8E;
}

.step-select-btn.current {
  background: #241E1A;
  border-color: #241E1A;
}

.ss-code {
  font-size: 24rpx;
  font-weight: 700;
  color: #8D6238;
  margin-bottom: 6rpx;
}

.step-select-btn.current .ss-code {
  color: #E2B678;
}

.ss-name {
  font-size: 22rpx;
  color: #3A312A;
}

.step-select-btn.current .ss-name {
  color: #FFFFFF;
  font-weight: 600;
}

/* ==================== 咨询编辑与客户反馈回复样式 ==================== */
.cancel-edit-btn {
  font-size: 22rpx;
  color: #8C8074;
  background: #F2EDE6;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.his-top-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.his-feedback-badge {
  font-size: 20rpx;
  color: #9A8E82;
  background: #EFEBE5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.his-feedback-badge.done {
  color: #2E6F3A;
  background: #E9F5EB;
  font-weight: 600;
}

.his-client-feedback {
  margin-top: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #EAE0D2;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
}

.hcf-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.hcf-label {
  font-size: 21rpx;
  font-weight: 600;
  color: #8D6238;
}

.hcf-time {
  font-size: 20rpx;
  color: #9A8E82;
}

.hcf-txt {
  display: block;
  font-size: 23rpx;
  color: #3A312A;
  line-height: 1.5;
}

.his-consultant-reply {
  margin-top: 10rpx;
  background: #241E1A;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}

.hcr-label {
  font-size: 21rpx;
  color: #E2B678;
  font-weight: 600;
}

.hcr-txt {
  font-size: 22rpx;
  color: #F4EAE0;
  line-height: 1.45;
}

.his-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.his-act-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 12rpx 0;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #D8C7B4;
  color: #5C534A;
  font-weight: 500;
}

.his-act-btn.reply {
  background: #8D6238;
  border-color: #8D6238;
  color: #FFFFFF;
}

/* 顾问回复弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-box {
  background: #FFFFFF;
  width: 100%;
  border-radius: 24rpx;
  padding: 36rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #241E1A;
  margin-bottom: 14rpx;
}

.modal-sub-box {
  display: block;
  font-size: 23rpx;
  color: #594D43;
  background: #FAF7F2;
  border-left: 6rpx solid #8D6238;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
  line-height: 1.5;
}

.modal-textarea {
  width: 100%;
  height: 180rpx;
  background: #F9F7F3;
  border: 1rpx solid #E5DDD2;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.m-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.m-btn.cancel {
  background: #F2EDE6;
  color: #6B6158;
}

.m-btn.confirm {
  background: #8D6238;
  color: #FFFFFF;
}

/* ==================== 建档密码输入栏 ==================== */
.pwd-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.pwd-input {
  flex: 1;
}

.pwd-gen-btn {
  flex-shrink: 0;
  background: #F6EFE6;
  border: 1rpx solid #D8C3A8;
  color: #8D6238;
  font-size: 23rpx;
  font-weight: 600;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
}
